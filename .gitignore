.DS_Store
tmp/

# Build output: the shared library and the ASan variant.
lib/*.so
lib/*.dylib
lib/*.dll

# Test binaries.
tests/run_all
tests/run_all_release

nimcache/

# Databases this machine created.
*.glyph
*.glyph-wal
*.glyph-lock

# NOTE: do not ignore lib/glyphes/ — that is the Ruby source directory,
# not a build artifact. An early .gitignore did, and `rm -rf lib/glyphes`
# to clean a stale build then deleted the gem.

# History and watermark sidecars of a fixture database. The .vhist is a
# durable history, but these files are build outputs of `nimble fixture`,
# not source: the fixture generator writes them, and a checkout's first
# gate run regenerates them. Left untracked they dirtied the tree after
# every gate.
*.glyph-shm
*.glyph.vhist
