; ------------------------------------------------------------------------
; gbasic.z80 — GLYPH BASIC on the eZ80.
;
; The second implementation of the client's language, and the reason pin
; GB9 exists: the language has to be small enough to be written twice.
; The host client is Nim; this is Z80 assembly on an eZ80. The proof is
; the *transcript*: the same script, run on both, must produce the same
; bytes (PLAN-GLYPH-BASIC.md §6, E4).
;
; The graph is not here. The guest sends a GLYPH QUERY line over the
; port channel (ez80/channel.z80) and reads the answer back — so the
; guest needs no compiler and no graph, and the host does the work.
;
; What is here is the client's *own* part: the line, the statements, the
; names, the expressions, the loops, the request, the answer and the
; printing.
;
; This cut covers: find, count, labels, end, rem, let and bare
; assignment, input, print, show, go, if ... then, while, for, for each,
; gosub, return and the program model (PROGRAM-ID., SUBROUTINE.,
; END PROGRAM.), and the writes add, link, set and drop. The names are
; the client's, the expressions (arithmetic, text and comparisons) are
; the client's, the cursor loop is the client's, and the graph —
; including every write — still happens on the other side of the
; channel. A value is a number, a quoted text (copied into a 1 KB
; arena) or a yes/no, with the host's kind rules; `and`, `or` and `not`
; are in the condition grammar.
;
; The program is collected into a 2 KB buffer (at most 64 lines), its
; subroutine table is built during collection (eight names of fifteen
; characters), and its call stack holds sixteen lines. `gosub` pushes
; the line after the call; `return` pops it; a subroutine that reaches a
; declaration without a `return` is refused. `end` inside a program
; returns to the prompt; outside one it halts the machine. A bound
; reached is the guest's one-word `?`, never a truncation.
;
; An unknown name is refused rather than created, and an answer the host
; refuses (it begins with `!`) is printed as the same `?` — a refusal
; the child can see. An expression here is *word-shaped*: `1 + 2` is
; three words and the operators have to stand alone, because the guest
; tokenizes the line into words and has no character-by-character
; parser. That is the price of the budget, and the transcript tests only
; exercise what is here.
;
; Assemble:  nim c -r ez80/ez80asm.nim -- ez80/gbasic.z80 ez80/gbasic.bin
; ------------------------------------------------------------------------

CR      EQU 13
TAB     EQU 9

; ---- memory map ----------------------------------------------------
LINEBUF  EQU 0xD400     ; the line as read (100 bytes)
INBUF    EQU 0xD300     ; the line `input` reads (128 bytes)
WORDS    EQU 0xD470     ; the word offsets (64 bytes)
STARTS   EQU 0xD4B0     ; the word index each statement starts at (64)

WCOUNT   EQU 0xD4F0     ; the number of words
SCOUNT   EQU 0xD4F1     ; the number of statement boundaries
STMT     EQU 0xD4F2     ; the current statement's first word
SEND     EQU 0xD4F3     ; one past its last word
CURST    EQU 0xD4F4     ; the statement being run
RUNEND   EQU 0xD4F5     ; one past the last statement to run
EXW      EQU 0xD4F6     ; the expression's word cursor
NAMEI    EQU 0xD4F7     ; the statement's name word
GW       EQU 0xD4F8     ; `go`'s word cursor
FI       EQU 0xD4F9     ; the body scan's statement cursor
DEPTH    EQU 0xD4FA     ; the body scan's nesting depth
BODYEND  EQU 0xD4FB     ; the statement a body ends at (the `next`)
NUMCNT   EQU 0xD4FD     ; the digits being formatted
DIVCNT   EQU 0xD4FE     ; the division's counter
PNCNT    EQU 0xD4FF     ; the printed digits
OP       EQU 0xD500     ; the operator being applied
ACC      EQU 0xD501     ; the expression's accumulator (2)
ACC2     EQU 0xD503     ; the right-hand side (2)
VAL      EQU 0xD505     ; a value being moved around (2)
VAL2     EQU 0xD507     ; a second value (2)
VAL3     EQU 0xD509     ; a third value (2)
TXTPTR   EQU 0xD50B     ; the name being looked up (2)
ANSP     EQU 0xD50D     ; the answer line being printed (2)
TMP2     EQU 0xD50F     ; a general scratch (2)
TACC     EQU 0xD511     ; the term's accumulator (2)
TACC2    EQU 0xD513     ; the term's right-hand side (2)
LEVEL    EQU 0xD51E     ; how many RUNFROM frames are open (1 = the line)
MAKE     EQU 0xD51F     ; 1: a name may be created, 0: it must exist
COPE     EQU 0xD51D     ; the condition's comparison operator
WHCNT    EQU 0xD51A     ; a while's rounds (2)
WHEND    EQU 0xD519     ; a while's body end (the `next`, or the line end)
WHST     EQU 0xD518     ; a while's own statement index

ANSBUF   EQU 0xD520     ; the host's answer (128 bytes)
CURSOR   EQU 0xD5A0     ; the cursor as text (128 bytes)
CURSAVE  EQU 0xD620     ; a walk's copy of the cursor (4 x 128)
NAMETAB  EQU 0xD820     ; 8 names: 8 bytes of text and 2 of value
NUMBUF   EQU 0xD870     ; a number as text (16 bytes)
FSTART   EQU 0xD880     ; a loop's first body statement (4)
FEND     EQU 0xD884     ; a loop's body end (4)
CURP     EQU 0xD888     ; a walk's offset in its copy (4)
LDIDX    EQU 0xD88C     ; how many loops are open
FVAL     EQU 0xD890     ; a numeric loop's first value (4 x 2)
FLIM     EQU 0xD898     ; its last value (4 x 2)
FCUR     EQU 0xD8A0     ; where it is (4 x 2)

KINDS    EQU 0xD8A8     ; each name slot's kind (8): 0 number, 1 text, 2 yes/no
STRPTR   EQU 0xD8B0     ; the text arena's next free byte (2)
SLOTK    EQU 0xD8B2     ; the slot's kind byte (2)
RK       EQU 0xD8B4     ; an expression value's kind
ACK      EQU 0xD8B5     ; the add accumulator's kind
TACK     EQU 0xD8B6     ; the term accumulator's kind
TACK2    EQU 0xD8B7     ; the term's right-hand kind
VALK     EQU 0xD8B8     ; a comparison's left kind
VAL2K    EQU 0xD8B9     ; its right kind
TRES     EQU 0xD8BA     ; a saved truth value
TMP3     EQU 0xD8BB     ; text comparison scratch
TMP4     EQU 0xD8BC
TMP5     EQU 0xD8BD     ; text comparison lengths
TMP6     EQU 0xD8BE
TKQ      EQU 0xD8BF     ; the tokenizer is inside a quoted word

PGTMP    EQU 0xD8C0     ; the program model's scratch pointer (2)
PGIDX    EQU 0xD8C2     ; a subroutine table index (1)
PGLEN    EQU 0xD8C3     ; a collected line's length (1)

STRAREA  EQU 0xD900     ; the text arena: a length byte, then its bytes
STREND   EQU 0xDD00     ; one past the arena

; The program model. A collected program is a list of NUL-terminated
; lines in PROGBUF, with PROGTAB holding each line's offset. The call
; stack stores a line index per call (one byte; a program is at most 64
; lines), and the subroutine table is built once, at collection time,
; so `gosub` does not have to re-scan the program.
PROGBUF     EQU 0xDD00  ; 2 KB of program text
PROGBUF_END EQU 0xE500
PROGTAB     EQU 0xE500  ; 64 line offsets (2 bytes each)
PROGTOP     EQU 0xE580  ; the next free byte in PROGBUF (2)
PROGCNT     EQU 0xE582  ; how many lines were collected (1)
PROGPC      EQU 0xE583  ; the line being run (1)
PROGSP      EQU 0xE584  ; how many calls are open (1)
INPROG      EQU 0xE585  ; 1 while a collected program is running (1)
PROGSTK     EQU 0xE586  ; 16 return line indices
SUBNAMES    EQU 0xE600  ; 8 subroutine names, 16 bytes each
SUBLINES    EQU 0xE680  ; each one's body line (8)
SUBCNT      EQU 0xE690  ; how many subroutines (1)

STKTOP   EQU 0xBFF0

        ORG 0

; ---- startup --------------------------------------------------------
START:
        LD SP,STKTOP
        LD HL,STRAREA
        LD (STRPTR),HL
MAIN:
        LD SP,STKTOP        ; a refusal abandons the line, not the stack
        XOR A
        LD (LEVEL),A
        LD (LDIDX),A        ; no loop survives a refusal or an `end`
        CALL READLINE
        LD HL,LINEBUF
        LD DE,MSGPROGID
        CALL STARTSWITH
        OR A
        JR NZ,MAIN_LINE
        ; A program: collect it, run it, and come back to the prompt.
        CALL COLLECT
        CALL RUNPROG
        JR MAIN
MAIN_LINE:
        CALL TOKENIZE
        LD B,0
        LD A,(SCOUNT)
        LD C,A
        CALL RUNFROM
        JR MAIN

; ---- the program model -------------------------------------------------
; The host collects `PROGRAM-ID.` through `END PROGRAM.` and runs the
; lines as one program (PRD-GLYPH-BASIC.md §3.3). The guest does the
; same: the lines are copied into PROGBUF as NUL-terminated text, their
; offsets into PROGTAB, and the subroutine declarations into a table at
; collection time. Running a line copies it back into LINEBUF, so the
; tokenizer and every statement keep working on one line at a time.

; Is the line at LINEBUF exactly `END PROGRAM.` (case-insensitive)? The
; collection ends on that whole line, as the host prompt does.
ISENDLINE:
        LD HL,LINEBUF
        CALL STRIPAT
        LD DE,MSGENDLINE
        CALL STREQI
        RET

; Read the rest of a program and store it. LINEBUF already holds the
; PROGRAM-ID line. A blank line is skipped, as the host prompt skips it.
COLLECT:
        XOR A
        LD (PROGCNT),A
        LD (SUBCNT),A
        LD (PROGSP),A
        LD (INPROG),A
        LD HL,PROGBUF
        LD (PROGTOP),HL
        CALL STORELINE
CO_READ:
        CALL READLINE
        CALL ISENDLINE
        PUSH AF
        CALL STORELINE
        POP AF
        JR NZ,CO_READ
        RET

; Store the trimmed line in LINEBUF. It becomes PROGBUF's next
; NUL-terminated line, and a `SUBROUTINE.` declaration is entered into
; the table with its body line (the line after it).
STORELINE:
        LD HL,LINEBUF
        CALL STRIPAT          ; HL = start, C = length
        LD A,C
        OR A
        JR NZ,SLN_HAVE
        XOR A
        LD (WCOUNT),A         ; a blank line is not a statement
        RET
SLN_HAVE:
        LD (PGTMP),HL          ; source
        LD A,C
        LD (PGLEN),A           ; length
        LD A,(PROGCNT)
        CP 64
        JP NC,STERR
        ; end = PROGTOP + length + 1 (the NUL); it must fit PROGBUF.
        LD HL,(PROGTOP)
        LD E,C
        LD D,0
        ADD HL,DE
        INC HL
        LD DE,PROGBUF_END
        CALL CMPHLDE
        JR Z,SLN_ROOM
        JP C,SLN_ROOM
        JP STERR
SLN_ROOM:
        ; PROGTAB[PROGCNT] = the old PROGTOP
        LD A,(PROGCNT)
        LD L,A
        LD H,0
        ADD HL,HL
        LD DE,PROGTAB
        ADD HL,DE
        LD DE,(PROGTOP)
        LD (HL),E
        INC HL
        LD (HL),D
        ; copy the line and its NUL
        LD HL,(PGTMP)
        LD A,(PGLEN)
        LD C,A
        INC C
SLN_COPY:
        LD A,(HL)
        LD (DE),A
        INC HL
        INC DE
        DEC C
        JR NZ,SLN_COPY
        LD (PROGTOP),DE
        LD A,(PROGCNT)
        INC A
        LD (PROGCNT),A
        ; Tokenize the line to see whether it declares a subroutine.
        CALL TOKENIZE
        LD A,(WCOUNT)
        CP 2
        RET C
        XOR A
        CALL WORDAI
        LD DE,MSGSUBROUTINE
        CALL ISWORD
        OR A
        RET NZ
        LD A,1
        CALL WORDAI
        CALL CLEANDOT
        LD (PGTMP),HL
        CALL ADDSUB
        RET

; Remove one trailing dot from the NUL-terminated name at HL, in place.
CLEANDOT:
        LD D,H
        LD E,L
CLD_1:  LD A,(DE)
        OR A
        JR Z,CLD_2
        INC DE
        JR CLD_1
CLD_2:  DEC DE
        LD A,(DE)
        CP '.'
        RET NZ
        XOR A
        LD (DE),A
        RET

; HL = a subroutine name, PROGCNT = its body line. Replace a duplicate
; declaration (the host's table keeps the last one) or append it.
ADDSUB:
        LD (PGTMP),HL
        XOR A
        LD (PGIDX),A
AS_LOOP:
        LD A,(PGIDX)
        LD B,A
        LD A,(SUBCNT)
        CP B
        JR Z,AS_ADD
        JR C,AS_ADD
        LD A,(PGIDX)
        LD L,A
        LD H,0
        ADD HL,HL
        ADD HL,HL
        ADD HL,HL
        ADD HL,HL
        LD DE,SUBNAMES
        ADD HL,DE
        LD D,H
        LD E,L
        LD HL,(PGTMP)
        CALL NAMEEQ
        OR A
        JR Z,AS_FOUND
        LD A,(PGIDX)
        INC A
        LD (PGIDX),A
        JR AS_LOOP
AS_FOUND:
        LD A,(PGIDX)
        LD L,A
        LD H,0
        LD DE,SUBLINES
        ADD HL,DE
        LD A,(PROGCNT)
        LD (HL),A
        RET
AS_ADD:
        LD A,(SUBCNT)
        CP 8
        JP NC,STERR
        LD L,A
        LD H,0
        ADD HL,HL
        ADD HL,HL
        ADD HL,HL
        ADD HL,HL
        LD DE,SUBNAMES
        ADD HL,DE
        LD DE,(PGTMP)
        LD B,15
AS_CP1: LD A,(DE)
        OR A
        JR Z,AS_CP2
        LD (HL),A
        INC HL
        INC DE
        DJNZ AS_CP1
AS_CP2: LD (HL),0
        LD A,(SUBCNT)
        LD L,A
        LD H,0
        LD DE,SUBLINES
        ADD HL,DE
        LD A,(PROGCNT)
        LD (HL),A
        LD A,(SUBCNT)
        INC A
        LD (SUBCNT),A
        RET

; Copy program line A into LINEBUF.
PROGLINE:
        LD L,A
        LD H,0
        ADD HL,HL
        LD DE,PROGTAB
        ADD HL,DE
        LD E,(HL)
        INC HL
        LD D,(HL)
        EX DE,HL              ; the table holds the line's address
        LD DE,LINEBUF
PGL_1:  LD A,(HL)
        LD (DE),A
        OR A
        RET Z
        INC HL
        INC DE
        JR PGL_1

; Is the tokenized line at LINEBUF structure rather than a statement?
; Z if it is (blank, `SUBROUTINE.`, or `END PROGRAM.`).
ISDECL:
        LD A,(WCOUNT)
        OR A
        JR Z,ID_YES
        XOR A
        CALL WORDAI
        LD DE,MSGSUBROUTINE
        CALL ISWORD
        OR A
        JR Z,ID_YES
        XOR A
        CALL WORDAI
        LD DE,MSGEND
        CALL ISWORD
        OR A
        JR NZ,ID_NO
        LD A,(WCOUNT)
        CP 2
        JR C,ID_NO
        LD A,1
        CALL WORDAI
        LD DE,MSGPROGRAM
        CALL ISWORD
        OR A
        JR Z,ID_YES
ID_NO:  LD A,1
        OR A
        RET
ID_YES: XOR A
        RET

; Run the collected program. The first line must be `PROGRAM-ID. <name>`;
; the body starts at line 1, and the first declaration ends the main
; body. A call pushes the line after the `gosub`; `return` pops it.
RUNPROG:
        XOR A
        LD (PROGSP),A
        CALL PROGLINE
        CALL TOKENIZE
        LD A,(WCOUNT)
        CP 2
        JP C,STERR
        XOR A
        CALL WORDAI
        LD DE,MSGPROGID
        CALL ISWORD
        OR A
        JP NZ,STERR
        LD A,1
        LD (PROGPC),A
        LD (INPROG),A
RP_LOOP:
        LD A,(PROGPC)
        LD B,A
        LD A,(PROGCNT)
        CP B
        JR Z,RP_DONE
        JR C,RP_DONE
        LD A,(PROGPC)
        CALL PROGLINE
        LD A,(PROGPC)
        INC A
        LD (PROGPC),A
        CALL TOKENIZE
        CALL ISDECL
        JR Z,RP_DECL
        LD B,0
        LD A,(SCOUNT)
        LD C,A
        CALL RUNFROM
        JR RP_LOOP
RP_DECL:
        LD A,(PROGSP)
        OR A
        JR NZ,RP_BADRET
RP_DONE:
        XOR A
        LD (INPROG),A
        LD (PROGSP),A
        JP MAIN
RP_BADRET:
        JP STERR

; ---- gosub <name> ------------------------------------------------------
STGOSUB:
        LD A,(STMT)
        ADD A,2
        LD B,A
        LD A,(SEND)
        CP B
        JP NZ,STERR
        JP C,STERR
        LD A,(INPROG)
        OR A
        JP Z,STERR
        LD A,(STMT)
        INC A
        CALL WORDAI
        CALL CLEANDOT
        LD (PGTMP),HL
        XOR A
        LD (PGIDX),A
GS_LOOP:
        LD A,(PGIDX)
        LD B,A
        LD A,(SUBCNT)
        CP B
        JR Z,GS_NO
        JR C,GS_NO
        LD A,(PGIDX)
        LD L,A
        LD H,0
        ADD HL,HL
        ADD HL,HL
        ADD HL,HL
        ADD HL,HL
        LD DE,SUBNAMES
        ADD HL,DE
        LD D,H
        LD E,L
        LD HL,(PGTMP)
        CALL NAMEEQ
        OR A
        JR Z,GS_FOUND
        LD A,(PGIDX)
        INC A
        LD (PGIDX),A
        JR GS_LOOP
GS_FOUND:
        LD A,(PROGSP)
        CP 16
        JP NC,STERR
        LD L,A
        LD H,0
        LD DE,PROGSTK
        ADD HL,DE
        LD A,(PROGPC)
        LD (HL),A
        LD A,(PROGSP)
        INC A
        LD (PROGSP),A
        LD A,(PGIDX)
        LD L,A
        LD H,0
        LD DE,SUBLINES
        ADD HL,DE
        LD A,(HL)
        LD (PROGPC),A
        RET
GS_NO:  JP STERR

; ---- return ------------------------------------------------------------
STRETURN:
        LD A,(STMT)
        INC A
        LD B,A
        LD A,(SEND)
        CP B
        JP NZ,STERR
        LD A,(INPROG)
        OR A
        JP Z,STERR
        LD A,(PROGSP)
        OR A
        JP Z,STERR
        DEC A
        LD (PROGSP),A
        LD L,A
        LD H,0
        LD DE,PROGSTK
        ADD HL,DE
        LD A,(HL)
        LD (PROGPC),A
        RET

; ---- the console -----------------------------------------------------

; Print the NUL-terminated string at HL.
PRSTR:
        LD A,(HL)
        OR A
        RET Z
        OUT (1),A
        INC HL
        JR PRSTR

; Print the length-prefixed text at HL.
PRSLEN:
        LD A,(HL)
        OR A
        RET Z
        LD B,A
        INC HL
PSL1:   LD A,(HL)
        OUT (1),A
        INC HL
        DJNZ PSL1
        RET

; Print a space, then the string at HL.
PRSP:
        LD A,' '
        OUT (1),A
        JR PRSTR

; Print the number in HL, unsigned decimal.
PNUMU:
        LD A,H
        OR L
        JP NZ,PU1
        LD A,'0'
        CALL PUTCHAR
        RET
PU1:
        XOR A
        LD (PNCNT),A
PUL:
        LD DE,10
        CALL UDIV
        LD A,C
        ADD A,'0'
        PUSH AF
        LD A,(PNCNT)
        INC A
        LD (PNCNT),A
        LD A,H
        OR L
        JP NZ,PUL
PUP:
        POP AF
        CALL PUTCHAR
        LD A,(PNCNT)
        DEC A
        LD (PNCNT),A
        JP NZ,PUP
        RET

PUTCHAR:
        OUT (1),A
        RET

; UDIV: HL / DE. The quotient in HL, the remainder in C.
UDIV:
        LD A,D
        OR E
        JP Z,DVERR
        LD BC,0
        LD A,16
        LD (DIVCNT),A
DVLP:
        ADD HL,HL
        RL C
        RL B
        LD A,C
        SUB E
        LD A,B
        SBC A,D
        JP C,DVSK
        LD A,C
        SUB E
        LD C,A
        LD A,B
        SBC A,D
        LD B,A
        INC L
DVSK:
        LD A,(DIVCNT)
        DEC A
        LD (DIVCNT),A
        JP NZ,DVLP
        RET
DVERR:
        LD A,'?'
        OUT (1),A
        RET

; MUL16: HL * DE -> HL (the low 16 bits). The multiplicand shifts
; left, the multiplier shifts right, and the product gathers in BC.
MUL16:
        LD BC,0
        LD A,16
        LD (DIVCNT),A
MU1:    LD A,E
        AND 1
        JR Z,MU2
        LD A,C
        ADD A,L
        LD C,A
        LD A,B
        ADC A,H
        LD B,A
MU2:    ADD HL,HL
        SRL E
        RR D
        LD A,(DIVCNT)
        DEC A
        LD (DIVCNT),A
        JR NZ,MU1
        LD H,B
        LD L,C
        RET

; ---- the line and the words ------------------------------------------

; Read a line from the console into LINEBUF.
READLINE:
        LD HL,LINEBUF
        JP READINTO

; Read a console line into HL (NUL-terminated), and answer its length in
; A. The buffer is separate so `input` can read while a statement or a
; loop body is still using the line it came from.
READINTO:
        LD B,0
RL1:    IN A,(2)
        OR A
        JR Z,RL1
        IN A,(1)
        CP CR
        JR Z,RL2
        LD (HL),A
        INC HL
        INC B
        JR RL1
RL2:    LD (HL),0
        LD A,B
        RET

; Strip spaces and tabs from both ends of the NUL-terminated line at HL.
; The line is shortened in place; HL comes back at its first character,
; and C is its length. `input` and a program line both want this rule.
STRIPAT:
        LD (TMP2),HL
ST_LEAD:
        LD A,(HL)
        CP ' '
        JR Z,ST_L1
        CP TAB
        JR NZ,ST_START
ST_L1:  INC HL
        JR ST_LEAD
ST_START:
        LD (TMP2),HL
ST_SCAN:
        LD A,(HL)
        OR A
        JR Z,ST_TRIM
        INC HL
        JR ST_SCAN
ST_TRIM:
        LD DE,(TMP2)
ST_BACK:
        LD A,L
        CP E
        JR NZ,ST_B1
        LD A,H
        CP D
        JR Z,ST_DONE
ST_B1:  DEC HL
        LD A,(HL)
        CP ' '
        JR Z,ST_BACK
        CP TAB
        JR Z,ST_BACK
        INC HL
ST_DONE:
        LD (HL),0
        LD DE,(TMP2)
        LD A,L
        SUB E
        LD C,A
        LD H,D
        LD L,E
        RET

; Split the line into words and statements.
;
; A word is a run of characters. The space after it becomes its NUL.
; A colon is a *statement boundary*: it becomes a NUL too, and the word
; that follows starts a new statement. STARTS[j] is the word index
; statement j begins at; STARTS[SCOUNT] is WCOUNT (the sentinel), so a
; statement is the words [STARTS[j], STARTS[j+1]).
TOKENIZE:
        XOR A
        LD (TKQ),A             ; a refusal must not leave the next line quoted
        LD (WCOUNT),A
        LD A,1
        LD (SCOUNT),A          ; the line is at least one statement
        LD HL,STARTS
        LD (HL),0
        LD HL,LINEBUF
        LD C,0
TK1:    LD A,(HL)
        OR A
        JP Z,TKEND
        CP ' '
        JR Z,TKSPACE
        CP ':'
        JR Z,TKCOLON
        ; a word begins here
        LD A,(WCOUNT)
        LD E,A
        LD D,0
        PUSH HL
        LD HL,WORDS
        ADD HL,DE
        LD (HL),C
        POP HL
        LD A,(WCOUNT)
        INC A
        LD (WCOUNT),A
TK2:    LD A,(TKQ)
        OR A
        JR NZ,TK2Q
        LD A,(HL)
        OR A
        JP Z,TKEND
        CP ' '
        JR Z,TKSPACE
        CP ':'
        JR Z,TK1              ; the boundary handler takes it
        CP 34
        JR Z,TK2OPEN
        INC HL
        INC C
        JR TK2
TK2Q:   LD A,(HL)
        OR A
        JP Z,TKEND
        CP 34
        JR Z,TK2CLOSE
        INC HL
        INC C
        JR TK2Q
TK2OPEN:
        LD A,1
        LD (TKQ),A
        INC HL
        INC C
        JR TK2
TK2CLOSE:
        XOR A
        LD (TKQ),A
        INC HL
        INC C
        JR TK2
TKSPACE:
        LD A,0
        LD (HL),A
        INC HL
        INC C
        JR TK1
TKCOLON:
        LD A,0
        LD (HL),A
        INC HL
        INC C
        LD A,(SCOUNT)
        LD E,A
        LD D,0
        PUSH HL
        LD HL,STARTS
        ADD HL,DE
        LD A,(WCOUNT)
        LD (HL),A
        POP HL
        LD A,(SCOUNT)
        INC A
        LD (SCOUNT),A
        JR TK1
TKEND:
        LD A,(SCOUNT)
        LD E,A
        LD D,0
        LD HL,STARTS
        ADD HL,DE
        LD A,(WCOUNT)
        LD (HL),A
        RET

; The address of word A (0-based) in HL.
WORDAI:
        LD L,A
        LD H,0
        LD DE,WORDS
        ADD HL,DE
        LD E,(HL)
        LD D,0
        LD HL,LINEBUF
        ADD HL,DE
        RET

; Is the word at HL the keyword at DE? The case is ignored, and the
; answer is in A: 0 for the same, 1 for different.
ISWORD:
ISW1:   LD A,(DE)
        OR A
        JR Z,ISW2
        LD A,(HL)
        OR A
        JR Z,ISWNO
        LD A,(DE)
        CP 'a'
        JR C,ISW3
        CP 123
        JR NC,ISW3
        SUB 32
ISW3:   LD B,A
        LD A,(HL)
        CP 'a'
        JR C,ISW4
        CP 123
        JR NC,ISW4
        SUB 32
ISW4:   CP B
        JR NZ,ISWNO
        INC HL
        INC DE
        JR ISW1
ISW2:   LD A,(HL)
        OR A
        JR Z,ISWYES
ISWNO:  LD A,1
        RET
ISWYES: LD A,0
        RET

; A = A uppercased, if it is an ASCII letter.
UPPER:
        CP 'a'
        RET C
        CP 123
        RET NC
        SUB 32
        RET

; Z if the NUL-terminated strings at HL and DE are equal, ignoring case.
STREQI:
        LD A,(DE)
        CALL UPPER
        LD B,A
        LD A,(HL)
        CALL UPPER
        CP B
        JR NZ,SQ_NO
        OR A
        RET Z
        INC HL
        INC DE
        JR STREQI
SQ_NO:  LD A,1
        OR A
        RET

; Z if the text at HL starts with the prefix at DE, ignoring case. The
; line's leading spaces and tabs are skipped; the host trims its lines
; before it looks for `PROGRAM-ID.`, so the guest does too.
STARTSWITH:
SW_SKIP:
        LD A,(HL)
        CP ' '
        JR Z,SW_SK1
        CP TAB
        JR NZ,SW1
SW_SK1: INC HL
        JR SW_SKIP
SW1:    LD A,(DE)
        CALL UPPER
        LD B,A
        OR A
        JR Z,SW_YES
        LD A,(HL)
        CALL UPPER
        CP B
        JR NZ,SW_NO
        INC HL
        INC DE
        JR SW1
SW_YES: XOR A
        RET
SW_NO:  LD A,1
        OR A
        RET

; ---- the channel ------------------------------------------------------

; Send the NUL-terminated string at HL to the host, with no terminator.
SENDPART:
        LD A,(HL)
        OR A
        RET Z
        OUT (3),A
        INC HL
        JR SENDPART

; Send the NUL-terminated string at HL to the host, then CR.
SENDSTR:
        CALL SENDPART
        LD A,CR
        OUT (3),A
        RET

; Send the number in HL to the host as decimal.
SENDNUM:
        CALL NUMTXT
        JP SENDPART

; Send the length-prefixed text at HL as a quoted channel parameter:
; "..." — the channel's text form, spaces and all.
SENDQT:
        LD A,'"'
        OUT (3),A
        LD A,(HL)
        OR A
        JR Z,SQ_E
        LD B,A
        INC HL
SQ1:    LD A,(HL)
        OUT (3),A
        INC HL
        DJNZ SQ1
SQ_E:   LD A,'"'
        OUT (3),A
        RET

; Send the yes/no in HL.
SENDBOOL:
        LD A,H
        OR L
        JR Z,SB_F
        LD HL,MSGTRUE
        JP SENDPART
SB_F:   LD HL,MSGFALSE
        JP SENDPART

; The number in HL as decimal text at NUMBUF.
NUMTXT:
        LD A,0
        LD (NUMCNT),A
NT1:    LD DE,10
        CALL UDIV
        LD A,C
        ADD A,'0'
        PUSH AF
        LD A,(NUMCNT)
        INC A
        LD (NUMCNT),A
        LD A,H
        OR L
        JR NZ,NT1
        LD HL,NUMBUF
NT2:    POP AF
        LD (HL),A
        INC HL
        LD A,(NUMCNT)
        DEC A
        LD (NUMCNT),A
        JR NZ,NT2
        LD (HL),0
        LD HL,NUMBUF
        RET

; Read the host's answer into ANSBUF: the lines are NUL-separated, and
; the answer ends at the empty line.
READANS:
        LD HL,ANSBUF
        LD B,0
RA1:    IN A,(5)
        OR A
        JR Z,RA1
        IN A,(4)
        CP CR
        JR Z,RA2
        LD (HL),A
        INC HL
        INC B
        JR RA1
RA2:    IN A,(5)
        OR A
        JR Z,RA2
        IN A,(4)
        CP CR
        JR Z,RA3
        LD (HL),0
        INC HL
        INC B
        LD (HL),A
        INC HL
        INC B
        JR RA1
RA3:    LD (HL),0
        INC HL
        LD (HL),0             ; the empty line: the answer's end
        LD A,(ANSBUF)
        CP 33                 ; a refusal: the host says why, the guest
        JP Z,STERR            ; refuses by name — its one word for it
        RET

; Count the ids (the runs of digits) in the line at HL.
COUNTIDS:
        LD DE,0
CI1:    LD A,(HL)
        OR A
        JR Z,CIDONE
        CP '0'
        JR C,CINEXT
        CP 58
        JR NC,CINEXT
        INC DE
CI2:    INC HL
        LD A,(HL)
        CP '0'
        JR C,CI1
        CP 58
        JR NC,CI1
        JR CI2
CINEXT: INC HL
        JR CI1
CIDONE: LD H,D
        LD L,E
        RET

; Print the NUL-separated lines at HL, one per line.
PRTLINES:
        LD A,(HL)
        OR A
        RET Z
PT2:    LD A,(HL)
        OR A
        JR Z,PT3
        OUT (1),A
        INC HL
        JR PT2
PT3:    LD A,CR
        OUT (1),A
        INC HL
        JR PRTLINES

; Does the text at HL begin with the prefix at DE? Z if it does.
PREFIX:
        LD A,(DE)
        OR A
        JR Z,PYES
        LD B,A
        LD A,(HL)
        CP B
        JR NZ,PNO
        INC HL
        INC DE
        JR PREFIX
PYES:   XOR A
        RET
PNO:    LD A,1
        OR A
        RET

; Advance ANSP past the line it points at.
ANSNEXT:
        LD HL,(ANSP)
AN1:    LD A,(HL)
        OR A
        JR Z,AN2
        INC HL
        JR AN1
AN2:    INC HL
        LD (ANSP),HL
        RET

; Copy the NUL-terminated string at HL to DE.
COPYSTR:
        LD A,(HL)
        LD (DE),A
        OR A
        RET Z
        INC HL
        INC DE
        JR COPYSTR

; Clear the 128 bytes at HL.
CLRSLOT:
        LD B,128
        LD A,0
CL1:    LD (HL),A
        INC HL
        DJNZ CL1
        RET

; ---- the names --------------------------------------------------------

; Are the name at DE and the text at HL the same? Z if they are.
NAMEEQ:
        PUSH DE
NE1:    LD A,(DE)
        OR A
        JR Z,NEY
        LD B,A
        LD A,(HL)
        CP B
        JR NZ,NEN
        INC HL
        INC DE
        JR NE1
NEY:    LD A,(HL)
        OR A
        JR NZ,NEN
        POP DE
        XOR A
        RET
NEN:    POP DE
        LD A,1
        OR A
        RET

; The slot for the name at HL, and it must already exist: this is the
; reader's rule (`x` in an expression is a name the program made, and an
; unknown one is a refusal, not a new name with a zero in it).
FINDNAME:
        XOR A
        LD (MAKE),A
        JR SLOT0

; The slot for the name at HL. A new name is given a slot with a value
; of zero; a name that does not fit is refused.
SLOT:
        LD A,1
        LD (MAKE),A
SLOT0:
        LD (TXTPTR),HL
        LD DE,NAMETAB
        LD B,8
SL1:    PUSH BC
        PUSH DE
        LD HL,(TXTPTR)
        CALL NAMEEQ
        POP DE
        POP BC
        JR Z,SLHIT
        LD A,E
        ADD A,10
        LD E,A
        JR NC,SL2
        INC D
SL2:    DJNZ SL1
        LD DE,NAMETAB
        LD B,8
SL3:    LD A,(DE)
        OR A
        JR Z,SLNEW
        LD A,E
        ADD A,10
        LD E,A
        JR NC,SL4
        INC D
SL4:    DJNZ SL3
        JP STERR
SLHIT:
        PUSH DE
        LD A,8
        SUB B
        LD E,A
        LD D,0
        LD HL,KINDS
        ADD HL,DE
        LD (SLOTK),HL
        POP DE
        LD H,D
        LD L,E
        RET
SLNEW:
        LD A,(MAKE)
        OR A
        JP Z,STERR
        PUSH DE
        LD A,8
        SUB B
        LD L,A
        LD H,0
        LD DE,KINDS
        ADD HL,DE
        LD (SLOTK),HL
        LD (HL),0
        POP DE
        PUSH DE
        LD HL,(TXTPTR)
        LD B,7
SLC1:   LD A,(HL)
        OR A
        JR Z,SLC2
        LD (DE),A
        INC HL
        INC DE
        DEC B
        JR NZ,SLC1
SLC2:   LD A,0
        LD (DE),A
        POP HL
        PUSH HL
        LD DE,8
        ADD HL,DE
        LD (HL),0
        INC HL
        LD (HL),0
        POP HL
        RET

; The value of the word at HL: a number, a name's value, or a quoted
; text. A value's kind is left in RK (0 number, 1 text, 2 yes/no); a
; text value is a pointer to a length byte in the arena.
GETVAL:
        LD (TXTPTR),HL
        LD A,(HL)
        CP 34
        JP Z,GVSTR
GV1:    LD A,(HL)
        OR A
        JR Z,GVNUM
        CP '0'
        JR C,GVNAME
        CP 58
        JR NC,GVNAME
        INC HL
        JR GV1
GVNUM:  LD HL,(TXTPTR)
        CALL PARSENUM
        XOR A
        LD (RK),A
        RET
GVNAME: LD HL,(TXTPTR)
        CALL FINDNAME
        PUSH HL
        LD HL,(SLOTK)
        LD A,(HL)
        LD (RK),A
        POP HL
        LD DE,8
        ADD HL,DE
        LD E,(HL)
        INC HL
        LD D,(HL)
        LD H,D
        LD L,E
        RET
GVSTR:
        ; the word is "..." — the tokenizer kept its spaces and colons;
        ; both quotes must be there, and the inside is copied into the
        ; arena so a name can outlive the line it was read on
        LD HL,(TXTPTR)
        LD B,0
        LD D,H
        LD E,L
GVSL:   LD A,(DE)
        OR A
        JR Z,GVSLE
        INC DE
        INC B
        JR GVSL
GVSLE:  LD A,B
        CP 2
        JP C,STERR
        DEC DE
        LD A,(DE)
        CP 34
        JP NZ,STERR
        LD A,B
        SUB 2
        LD C,A
        CALL STRALLOC
        LD (VAL3),HL
        INC HL
        LD DE,(TXTPTR)
        INC DE
        LD A,C
        OR A
        JR Z,GVSEND
        LD B,C
GVSC:   LD A,(DE)
        LD (HL),A
        INC DE
        INC HL
        DJNZ GVSC
GVSEND: LD HL,(VAL3)
        LD A,1
        LD (RK),A
        RET

; The node id in the word at HL. A text or yes/no is refused, as the
; host's nodeOf refuses it; a number (and so a node id) is taken.
NODEID:
        CALL GETVAL
        LD A,(RK)
        OR A
        JP NZ,STERR
        RET

; C = a text's length -> HL = its new home in the arena. The byte before
; the text holds its length, and the arena's free pointer moves past it.
; A full arena is a refusal, not an overwrite.
STRALLOC:
        LD HL,(STRPTR)
        PUSH HL
        LD E,C
        LD D,0
        ADD HL,DE
        INC HL
        LD DE,STREND
        LD A,H
        CP D
        JR C,SA_OK
        JR NZ,SA_FULL
        LD A,L
        CP E
        JR C,SA_OK
        JR Z,SA_OK
SA_FULL:
        POP HL
        JP STERR
SA_OK:  POP HL
        PUSH HL
        LD A,C
        LD (HL),A
        INC HL
        LD E,C
        LD D,0
        ADD HL,DE
        LD (STRPTR),HL
        POP HL
        RET

; HL and DE are two text values -> HL is their concatenation.
CONCAT:
        LD (VAL),HL
        LD (VAL2),DE
        LD A,(HL)
        LD C,A
        LD A,(DE)
        ADD A,C
        JP C,STERR
        LD C,A
        CALL STRALLOC
        LD (VAL3),HL
        INC HL
        LD DE,(VAL)
        LD A,(DE)
        LD B,A
        OR A
        JR Z,CC_RIGHT
        INC DE
CC_L:   LD A,(DE)
        LD (HL),A
        INC DE
        INC HL
        DJNZ CC_L
CC_RIGHT:
        LD DE,(VAL2)
        LD A,(DE)
        LD B,A
        OR A
        JR Z,CC_DONE
        INC DE
CC_R:   LD A,(DE)
        LD (HL),A
        INC DE
        INC HL
        DJNZ CC_R
CC_DONE:
        LD HL,(VAL3)
        LD A,1
        LD (RK),A
        RET

; HL and DE are two text values -> Z if exactly equal (`=` and `<>`).
STREQ:
        LD A,(DE)
        LD B,A
        CP (HL)
        JR NZ,SEQ_N
        INC HL
        INC DE
SEQ1:   LD A,B
        OR A
        JR Z,SEQ_Y
        LD A,(DE)
        CP (HL)
        JR NZ,SEQ_N
        INC HL
        INC DE
        DEC B
        JR SEQ1
SEQ_Y:  XOR A
        RET
SEQ_N:  LD A,1
        OR A
        RET

; HL and DE are two text values -> Z equal, C HL < DE, case ignored
; (`<`, `>`, `<=`, `>=` — the host's ordering).
CMPSTRI:
        LD A,(HL)
        LD (TMP5),A
        LD A,(DE)
        LD (TMP6),A
        INC HL
        INC DE
CS1:    LD A,(TMP5)
        OR A
        JR Z,CS_LEFTEND
        LD A,(TMP6)
        OR A
        JR Z,CS_GREATER
        LD A,(HL)
        CALL TOLOWER
        LD (TMP3),A
        LD A,(DE)
        CALL TOLOWER
        LD (TMP4),A
        LD A,(TMP4)
        LD B,A
        LD A,(TMP3)
        CP B
        JR C,CS_LESS
        JR NZ,CS_GREATER
        INC HL
        INC DE
        LD A,(TMP5)
        DEC A
        LD (TMP5),A
        LD A,(TMP6)
        DEC A
        LD (TMP6),A
        JR CS1
CS_LEFTEND:
        LD A,(TMP6)
        OR A
        JR Z,CS_EQUAL
CS_LESS:
        SCF
        RET
CS_GREATER:
        LD A,1
        OR A
        RET
CS_EQUAL:
        XOR A
        RET

TOLOWER:
        CP 'A'
        RET C
        CP 91
        RET NC
        ADD A,32
        RET

; A = kind, HL = value -> A = 1 if true, 0 if false. HL is left alone.
; A text is true when it is not empty; a number or yes/no when it is
; not zero — the host's `truthy`.
TRUTHY:
        CP 1
        JR Z,TR_TEXT
        LD A,H
        OR L
        JR Z,TR_FALSE
        LD A,1
        RET
TR_TEXT:
        LD A,(HL)
        OR A
        JR Z,TR_FALSE
        LD A,1
        RET
TR_FALSE:
        XOR A
        RET

; The decimal number at HL, in HL.
PARSENUM:
        LD DE,0
PN1:    LD A,(HL)
        OR A
        JR Z,PN2
        SUB '0'
        LD C,A
        PUSH HL
        LD H,D
        LD L,E
        ADD HL,HL
        ADD HL,HL
        ADD HL,DE
        ADD HL,HL
        LD B,0
        ADD HL,BC
        LD D,H
        LD E,L
        POP HL
        INC HL
        JR PN1
PN2:    LD H,D
        LD L,E
        RET

; ---- the expressions ---------------------------------------------------

; The word at EXW, or the empty string.
PEEKW:
        LD A,(EXW)
        LD B,A
        LD A,(SEND)
        CP B
        JR Z,PKE
        JR C,PKE
        LD A,B
        CALL WORDAI
        RET
PKE:    LD HL,MSGEMPTY
        RET

; eval := or
; or   := and ('or' and)*
; and  := not ('and' not)*
; not  := 'not' not | cmp
; cmp  := add (('='|'<'|'>'|'<='|'>='|'<>') add)?
; add  := term (('+'|'-') term)*
; term := primary (('*'|'/') primary)*
; primary := a number | a "text" | a name
;
; A value is HL and a kind in RK: 0 number (a node id is one), 1 text
; (HL points at a length byte), 2 yes/no (HL is 0 or 1). `and` and `or`
; are eager, like the host's evaluator; `not` binds looser than a
; comparison, so `not 1 = 1` is `not (1 = 1)`. Text ordering ignores
; case, text equality does not, and two different kinds are unequal
; rather than an error — the host's rules, inherited.
EVAL:
        CALL EOR
        RET

EOR:
        CALL EAND
EO1:    PUSH HL
        LD A,(RK)
        PUSH AF
        CALL PEEKW
        LD DE,MSGOR
        CALL ISWORD
        OR A
        JR NZ,EO_NOMORE
        LD A,(EXW)
        INC A
        LD (EXW),A
        POP AF
        POP HL
        CALL TRUTHY
        PUSH AF
        CALL EAND
        LD A,(RK)
        CALL TRUTHY
        LD B,A
        POP AF
        OR B
        LD HL,0
        JR Z,EO_ST
        LD HL,1
EO_ST:  LD A,2
        LD (RK),A
        JR EO1
EO_NOMORE:
        POP AF
        POP HL
        LD (RK),A
        RET

EAND:
        CALL CNOT
EA1:    PUSH HL
        LD A,(RK)
        PUSH AF
        CALL PEEKW
        LD DE,MSGAND
        CALL ISWORD
        OR A
        JR NZ,EA_NOMORE
        LD A,(EXW)
        INC A
        LD (EXW),A
        POP AF
        POP HL
        CALL TRUTHY
        PUSH AF
        CALL CNOT
        LD A,(RK)
        CALL TRUTHY
        LD B,A
        POP AF
        AND B
        LD HL,0
        JR Z,EA_ST
        LD HL,1
EA_ST:  LD A,2
        LD (RK),A
        JR EA1
EA_NOMORE:
        POP AF
        POP HL
        LD (RK),A
        RET

CNOT:
        PUSH HL
        LD A,(RK)
        PUSH AF
        CALL PEEKW
        LD DE,MSGNOT
        CALL ISWORD
        OR A
        JR NZ,CN_NOMORE
        LD A,(EXW)
        INC A
        LD (EXW),A
        POP AF
        POP HL
        CALL CNOT
        LD A,(RK)
        CALL TRUTHY
        XOR 1
        LD L,A
        LD H,0
        LD A,2
        LD (RK),A
        RET
CN_NOMORE:
        POP AF
        POP HL
        LD (RK),A
        CALL CCMP
        RET

CCMP:
        CALL EXPR
        PUSH HL
        LD A,(RK)
        PUSH AF
        CALL PEEKW
        LD A,(HL)
        CP '='
        JR Z,CD_EQ
        CP '<'
        JR Z,CD_LT
        CP '>'
        JR Z,CD_GT
        ; no operator: the value itself is the comparison's answer
        POP AF
        POP HL
        LD (RK),A
        RET
CD_EQ:  LD A,'='
        JR CD_OP
CD_LT:  INC HL
        LD A,(HL)
        CP '='
        JR Z,CD_LE
        CP '>'
        JR Z,CD_NE
        LD A,'<'
        JR CD_OP
CD_LE:  LD A,'l'
        JR CD_OP
CD_NE:  LD A,'n'
        JR CD_OP
CD_GT:  INC HL
        LD A,(HL)
        CP '='
        JR Z,CD_GE
        LD A,'>'
        JR CD_OP
CD_GE:  LD A,'g'
CD_OP:  LD (COPE),A
        LD A,(EXW)
        INC A
        LD (EXW),A
        CALL EXPR
        LD (VAL2),HL
        LD A,(RK)
        LD (VAL2K),A
        POP AF
        POP HL
        LD (VAL),HL
        LD (VALK),A
        LD A,(VALK)
        OR A
        JR Z,CC_NUM
        CP 1
        JR Z,CC_TEXT
        ; a yes/no: only = and <> order nothing
        JR CC_BOOL
CC_NUM:
        LD A,(VAL2K)
        OR A
        JR Z,CC_NN
        JP CC_DIFF
CC_TEXT:
        LD A,(VAL2K)
        CP 1
        JP Z,CC_TT
        JP CC_DIFF
CC_BOOL:
        LD A,(VAL2K)
        CP 2
        JP Z,CC_BB
        JP CC_DIFF
CC_DIFF:
        LD A,(COPE)
        CP '='
        JP Z,CC_FALSE
        CP 'n'
        JP Z,CC_TRUE
        JP STERR
CC_NN:
        LD HL,(VAL)
        LD DE,(VAL2)
        LD A,(COPE)
        CP '='
        JR Z,CCN_EQ
        CP 'n'
        JR Z,CCN_NE
        CP '<'
        JR Z,CCN_LT
        CP 'l'
        JR Z,CCN_LE
        CP '>'
        JR Z,CCN_GT
        CALL CMPHLDE
        JP C,CC_FALSE
        JP CC_TRUE
CCN_LT: CALL CMPHLDE
        JP C,CC_TRUE
        JP CC_FALSE
CCN_GT: CALL CMPHLDE
        JP Z,CC_FALSE
        JP C,CC_FALSE
        JP CC_TRUE
CCN_EQ: CALL CMPHLDE
        JP Z,CC_TRUE
        JP CC_FALSE
CCN_NE: CALL CMPHLDE
        JP NZ,CC_TRUE
        JP CC_FALSE
CCN_LE: CALL CMPHLDE
        JP Z,CC_TRUE
        JP C,CC_TRUE
        JP CC_FALSE
CC_TT:
        LD HL,(VAL)
        LD DE,(VAL2)
        LD A,(COPE)
        CP '='
        JR Z,CCT_EQ
        CP 'n'
        JR Z,CCT_NE
        CALL CMPSTRI
        PUSH AF
        LD A,(COPE)
        CP '<'
        JR Z,CCT_LT
        CP 'l'
        JR Z,CCT_LE
        CP '>'
        JR Z,CCT_GT
        ; 'g'
        POP AF
        JP C,CC_FALSE
        JP CC_TRUE
CCT_LT: POP AF
        JP C,CC_TRUE
        JP CC_FALSE
CCT_GT: POP AF
        JP C,CC_FALSE
        JP Z,CC_FALSE
        JP CC_TRUE
CCT_LE: POP AF
        JP C,CC_TRUE
        JP Z,CC_TRUE
        JP CC_FALSE
CCT_EQ: CALL STREQ
        JP Z,CC_TRUE
        JP CC_FALSE
CCT_NE: CALL STREQ
        JP NZ,CC_TRUE
        JP CC_FALSE
CC_BB:
        LD A,(COPE)
        CP '='
        JR Z,CCB_EQ
        CP 'n'
        JR Z,CCB_NE
        JP STERR
CCB_EQ: LD HL,(VAL)
        LD DE,(VAL2)
        CALL CMPHLDE
        JP Z,CC_TRUE
        JP CC_FALSE
CCB_NE: LD HL,(VAL)
        LD DE,(VAL2)
        CALL CMPHLDE
        JP NZ,CC_TRUE
        JP CC_FALSE
CC_TRUE: LD HL,1
        LD A,2
        LD (RK),A
        RET
CC_FALSE: LD HL,0
        LD A,2
        LD (RK),A
        RET

; A condition is a value, true by the host's `truthy`; answers 0 or 1
; in HL, so the existing `LD A,H : OR L` callers keep their test.
COND:
        LD A,(STMT)
        INC A
        LD (EXW),A
        CALL EVAL
        LD A,(RK)
        CALL TRUTHY
        LD L,A
        LD H,0
        RET

; Store the value in HL and its kind in RK into the slot for the name
; word at A. The slot's value field is eight bytes in; its kind is at
; SLOTK, the parallel byte SLOT/FINDNAME found.
STOREVAL:
        CALL WORDAI
        CALL SLOT
        PUSH HL
        LD DE,8
        ADD HL,DE
        LD DE,(VAL)
        LD (HL),E
        INC HL
        LD (HL),D
        POP HL
        LD HL,(SLOTK)
        LD A,(RK)
        LD (HL),A
        RET

EXPR:
        CALL TERM
        LD (ACC),HL
        LD A,(RK)
        LD (ACK),A
EXL:    CALL PEEKW
        LD A,(HL)
        CP '+'
        JR Z,EXOP
        CP '-'
        JR Z,EXOP
        LD HL,(ACC)
        LD A,(ACK)
        LD (RK),A
        RET
EXOP:   LD (OP),A
        LD A,(EXW)
        INC A
        LD (EXW),A
        CALL TERM
        LD (ACC2),HL
        LD A,(RK)
        LD (TACK2),A
        LD A,(OP)
        CP '+'
        JR Z,EXADD
        LD A,(ACK)
        OR A
        JP NZ,STERR
        LD A,(TACK2)
        OR A
        JP NZ,STERR
        LD HL,(ACC)
        LD DE,(ACC2)
        CALL SUB16
        XOR A
        LD (RK),A
        JR EXST
EXADD:  LD A,(ACK)
        CP 1
        JR Z,EX_LEFTSTR
        LD A,(TACK2)
        CP 1
        JP Z,STERR
        LD A,(ACK)
        OR A
        JP NZ,STERR
        LD A,(TACK2)
        OR A
        JP NZ,STERR
        LD HL,(ACC)
        LD DE,(ACC2)
        ADD HL,DE
        XOR A
        LD (RK),A
        JR EXST
EX_LEFTSTR:
        LD A,(TACK2)
        CP 1
        JP NZ,STERR
        LD HL,(ACC)
        LD DE,(ACC2)
        CALL CONCAT
EXST:   LD (ACC),HL
        LD A,(RK)
        LD (ACK),A
        JP EXL

TERM:
        CALL PRIMARY
        LD (TACC),HL
        LD A,(RK)
        LD (TACK),A
TML:    CALL PEEKW
        LD A,(HL)
        CP '*'
        JR Z,TMOP
        CP '/'
        JR Z,TMOP
        LD HL,(TACC)
        LD A,(TACK)
        LD (RK),A
        RET
TMOP:   LD (OP),A
        LD A,(EXW)
        INC A
        LD (EXW),A
        CALL PRIMARY
        LD (TACC2),HL
        LD A,(RK)
        OR A
        JP NZ,STERR
        LD A,(TACK)
        OR A
        JP NZ,STERR
        LD HL,(TACC)
        LD DE,(TACC2)
        LD A,(OP)
        CP '*'
        JR NZ,TMDIV
        CALL MUL16
        JR TMST
TMDIV:  CALL UDIV
TMST:   XOR A
        LD (RK),A
        LD (TACC),HL
        JR TML

PRIMARY:
        CALL PEEKW
        LD A,(HL)
        OR A
        JP Z,STERR
        CALL GETVAL
        LD A,(EXW)
        INC A
        LD (EXW),A
        RET

; ---- the statements ----------------------------------------------------

; Run the statements [B, C).
RUNFROM:
        LD A,B
        CP C
        RET NC                 ; an empty (or reversed) range runs nothing
        LD A,(LEVEL)
        INC A
        LD (LEVEL),A
        LD A,(RUNEND)
        PUSH AF
        LD A,C
        LD (RUNEND),A
        LD A,B
        LD (CURST),A
RF1:    CALL RUNONE
        LD A,(CURST)
        INC A
        LD (CURST),A
        LD B,A
        LD A,(RUNEND)
        CP B
        JR Z,RF2
        JR C,RF2
        JR RF1
RF2:    POP AF
        LD (RUNEND),A
        LD A,(LEVEL)
        DEC A
        LD (LEVEL),A
        RET

; Run the statement at CURST.
RUNONE:
        LD A,(CURST)
        CALL SETBOUNDS
        LD A,E
        CP D
        RET Z
        JP RUNSTMT

; A = statement index -> D = its first word, E = one past its last.
BOUNDS:
        LD L,A
        LD H,0
        LD DE,STARTS
        ADD HL,DE
        LD A,(HL)
        INC HL
        LD E,(HL)
        LD D,A
        RET

; A = statement index -> STMT and SEND set to that statement's words.
; D and E are left as BOUNDS made them.
SETBOUNDS:
        CALL BOUNDS
        LD A,D
        LD (STMT),A
        LD A,E
        LD (SEND),A
        RET

RUNSTMT:
        ; a bare assignment: word[STMT+1] is "="
        LD A,(STMT)
        INC A
        LD B,A
        LD A,(SEND)
        CP B
        JR C,RS_KW
        JR Z,RS_KW
        LD A,B
        LD (EXW),A
        CALL WORDAI
        LD DE,MSGEQ
        CALL ISWORD
        OR A
        JP Z,STASSIGN
RS_KW:
        LD A,(STMT)
        CALL WORDAI
        LD DE,MSGFIND
        CALL ISWORD
        OR A
        JP Z,STFIND
        LD A,(STMT)
        CALL WORDAI
        LD DE,MSGCOUNT
        CALL ISWORD
        OR A
        JP Z,STCOUNT
        LD A,(STMT)
        CALL WORDAI
        LD DE,MSGLABELS
        CALL ISWORD
        OR A
        JP Z,STLABELS
        LD A,(STMT)
        CALL WORDAI
        LD DE,MSGEND
        CALL ISWORD
        OR A
        JP Z,STEND
        LD A,(STMT)
        CALL WORDAI
        LD DE,MSGLET
        CALL ISWORD
        OR A
        JP Z,STLET
        LD A,(STMT)
        CALL WORDAI
        LD DE,MSGINPUT
        CALL ISWORD
        OR A
        JP Z,STINPUT
        LD A,(STMT)
        CALL WORDAI
        LD DE,MSGGOSUB
        CALL ISWORD
        OR A
        JP Z,STGOSUB
        LD A,(STMT)
        CALL WORDAI
        LD DE,MSGRETURN
        CALL ISWORD
        OR A
        JP Z,STRETURN
        LD A,(STMT)
        CALL WORDAI
        LD DE,MSGPRINT
        CALL ISWORD
        OR A
        JP Z,STPRINT
        LD A,(STMT)
        CALL WORDAI
        LD DE,MSGSHOW
        CALL ISWORD
        OR A
        JP Z,STSHOW
        LD A,(STMT)
        CALL WORDAI
        LD DE,MSGGO
        CALL ISWORD
        OR A
        JP Z,STGO
        LD A,(STMT)
        CALL WORDAI
        LD DE,MSGIF
        CALL ISWORD
        OR A
        JP Z,STIF
        LD A,(STMT)
        CALL WORDAI
        LD DE,MSGWHILE
        CALL ISWORD
        OR A
        JP Z,STWHILE
        LD A,(STMT)
        CALL WORDAI
        LD DE,MSGREM
        CALL ISWORD
        OR A
        JP Z,STREM
        LD A,(STMT)
        CALL WORDAI
        LD DE,MSGADD
        CALL ISWORD
        OR A
        JP Z,STADD
        LD A,(STMT)
        CALL WORDAI
        LD DE,MSGLINK
        CALL ISWORD
        OR A
        JP Z,STLINK
        LD A,(STMT)
        CALL WORDAI
        LD DE,MSGSET
        CALL ISWORD
        OR A
        JP Z,STSET
        LD A,(STMT)
        CALL WORDAI
        LD DE,MSGDROP
        CALL ISWORD
        OR A
        JP Z,STDROP
        LD A,(STMT)
        CALL WORDAI
        LD DE,MSGFOR
        CALL ISWORD
        OR A
        JP Z,STFOR
        JP STERR

; ---- find <label> ------------------------------------------------------
STFIND:
        LD A,(STMT)
        INC A
        LD B,A
        LD A,(SEND)
        CP B
        JP Z,STERR
        JP C,STERR
        LD A,(STMT)
        ADD A,2
        LD B,A
        LD A,(SEND)
        CP B
        JP NZ,STERR
        LD HL,MSGQFIND
        CALL SENDPART
        LD A,(STMT)
        INC A
        CALL WORDAI
        CALL SENDSTR
        CALL READANS
        LD HL,ANSBUF
        LD DE,CURSOR
        CALL COPYSTR
        LD HL,ANSBUF
        CALL COUNTIDS
        CALL PNUMU
        LD HL,MSGNODES
        CALL PRSP
        LD A,CR
        OUT (1),A
        RET

; ---- count <label> -----------------------------------------------------
STCOUNT:
        LD A,(STMT)
        INC A
        LD B,A
        LD A,(SEND)
        CP B
        JP Z,STERR
        JP C,STERR
        LD A,(STMT)
        ADD A,2
        LD B,A
        LD A,(SEND)
        CP B
        JP NZ,STERR
        LD HL,MSGQCOUNT
        CALL SENDPART
        LD A,(STMT)
        INC A
        CALL WORDAI
        CALL SENDSTR
        CALL READANS
        LD HL,ANSBUF
        CALL PRSTR
        LD A,CR
        OUT (1),A
        RET

; ---- labels ------------------------------------------------------------
STLABELS:
        LD HL,MSGQLABELS
        CALL SENDSTR
        CALL READANS
        LD HL,ANSBUF
        CALL PRTLINES
        RET

; ---- end ---------------------------------------------------------------
STEND:
        LD A,(INPROG)
        OR A
        JR NZ,STEND_PROG
        HALT
STEND_PROG:
        XOR A
        LD (INPROG),A
        LD (PROGSP),A
        JP MAIN

; ---- let <name> = <expr> -----------------------------------------------
STLET:
        LD A,(STMT)
        ADD A,2
        LD B,A
        LD A,(SEND)
        CP B
        JP Z,STERR
        JP C,STERR
        LD A,B
        CALL WORDAI
        LD DE,MSGEQ
        CALL ISWORD
        OR A
        JP NZ,STERR
        LD A,(STMT)
        ADD A,3
        LD B,A
        LD A,(SEND)
        CP B
        JP Z,STERR
        JP C,STERR
        LD A,(STMT)
        INC A
        LD (NAMEI),A
        ADD A,2
        LD (EXW),A
        CALL EVAL
        LD (VAL),HL
        LD A,(EXW)
        LD B,A
        LD A,(SEND)
        CP B
        JP NZ,STERR
        LD A,(NAMEI)
        CALL STOREVAL
        RET

; ---- input <name> ------------------------------------------------------
; Read the next console line into a name. The line is stripped at both
; ends; a line that is all digits is a number, anything else is text —
; the host's rule, inherited, because `input n` then `n > 5` must not
; compare text. The buffer is separate from LINEBUF so a loop body or
; the statement itself stays intact while the line is read.
STINPUT:
        LD A,(STMT)
        ADD A,2
        LD B,A
        LD A,(SEND)
        CP B
        JP NZ,STERR
        JP C,STERR
        LD A,(STMT)
        INC A
        LD (NAMEI),A
        LD HL,INBUF
        CALL READINTO
        LD HL,INBUF
        CALL STRIPAT
        LD (VAL2),HL
        ; all digits (and not empty) is a number
        LD A,C
        OR A
        JR Z,IN_TEXT
        LD HL,(VAL2)
        LD B,C
IN_DIG: LD A,(HL)
        CP '0'
        JR C,IN_TEXT
        CP 58
        JR NC,IN_TEXT
        INC HL
        DJNZ IN_DIG
        LD HL,(VAL2)
        CALL PARSENUM
        XOR A
        LD (RK),A
        JR IN_STORE
IN_TEXT:
        CALL STRALLOC
        LD (VAL3),HL
        INC HL
        LD DE,(VAL2)
        LD A,C
        OR A
        JR Z,IN_TEXT_END
        LD B,C
IN_TC:  LD A,(DE)
        LD (HL),A
        INC DE
        INC HL
        DJNZ IN_TC
IN_TEXT_END:
        LD HL,(VAL3)
        LD A,1
        LD (RK),A
IN_STORE:
        LD (VAL),HL
        LD A,(NAMEI)
        CALL STOREVAL
        RET

; ---- <name> = <expr> ---------------------------------------------------
STASSIGN:
        LD A,(STMT)
        ADD A,2
        LD B,A
        LD A,(SEND)
        CP B
        JP Z,STERR
        JP C,STERR
        LD A,(STMT)
        LD (NAMEI),A
        LD A,(STMT)
        ADD A,2
        LD (EXW),A
        CALL EVAL
        LD (VAL),HL
        LD A,(EXW)
        LD B,A
        LD A,(SEND)
        CP B
        JP NZ,STERR
        LD A,(NAMEI)
        CALL STOREVAL
        RET

; ---- print [<expr>] ----------------------------------------------------
STPRINT:
        LD A,(STMT)
        INC A
        LD B,A
        LD A,(SEND)
        CP B
        JR Z,PRCUR
        LD A,B
        LD (EXW),A
        CALL EVAL
        LD (VAL),HL
        LD A,(RK)
        LD (VALK),A
        LD A,(EXW)
        LD B,A
        LD A,(SEND)
        CP B
        JP NZ,STERR
        LD A,(VALK)
        CP 1
        JR Z,PR_TEXT
        CP 2
        JR Z,PR_BOOL
        LD HL,(VAL)
        CALL PNUMU
        JR PR_NL
PR_TEXT:
        LD HL,(VAL)
        CALL PRSLEN
        JR PR_NL
PR_BOOL:
        LD HL,(VAL)
        LD A,H
        OR L
        JR Z,PR_FALSE
        LD HL,MSGTRUE
        JR PR_WORD
PR_FALSE:
        LD HL,MSGFALSE
PR_WORD:
        CALL PRSTR
PR_NL:  LD A,CR
        OUT (1),A
        RET
PRCUR:
        LD HL,CURSOR
        CALL COUNTIDS
        LD A,H
        OR L
        JR Z,PR_EMPTY
        CALL PNUMU
        LD HL,MSGNODES
        CALL PRSP
        LD A,CR
        OUT (1),A
        RET
PR_EMPTY:
        LD HL,MSGCURSOREMPTY
        CALL PRSTR
        LD A,CR
        OUT (1),A
        RET

; ---- show <name> -------------------------------------------------------
STSHOW:
        LD A,(STMT)
        INC A
        LD B,A
        LD A,(SEND)
        CP B
        JP Z,STERR
        JP C,STERR
        LD A,(STMT)
        ADD A,2
        LD B,A
        LD A,(SEND)
        CP B
        JP NZ,STERR
        LD A,(STMT)
        INC A
        CALL WORDAI
        CALL NODEID
        LD (VAL),HL
        CALL PNUMU
        ; the label and the properties
        LD HL,MSGQPROPS
        CALL SENDPART
        LD HL,(VAL)
        CALL SENDNUM
        LD A,CR
        OUT (3),A
        CALL READANS
        LD HL,ANSBUF
        LD (ANSP),HL
        LD HL,(ANSP)
        LD DE,MSGPROPLABEL
        CALL PREFIX
        JR NZ,SH_PROP
        LD HL,MSGCOLON
        CALL PRSTR
        LD HL,(ANSP)
        LD DE,6
        ADD HL,DE
        CALL PRSTR
        CALL ANSNEXT
SH_PROP:
        LD HL,(ANSP)
        LD A,(HL)
        OR A
        JR Z,SH_EDGES
        LD A,CR
        OUT (1),A
        LD HL,MSGINDENT
        CALL PRSTR
        LD HL,(ANSP)
        CALL PRSTR
        CALL ANSNEXT
        JR SH_PROP
SH_EDGES:
        LD HL,MSGQEDGES
        CALL SENDPART
        LD HL,(VAL)
        CALL SENDNUM
        LD A,CR
        OUT (3),A
        CALL READANS
        LD HL,ANSBUF
        LD (ANSP),HL
SH_E2:
        LD HL,(ANSP)
        LD A,(HL)
        OR A
        JR Z,SH_DONE
        LD A,CR
        OUT (1),A
        LD HL,MSGINDENT
        CALL PRSTR
        LD HL,(ANSP)
        CALL PRSTR
        CALL ANSNEXT
        JR SH_E2
SH_DONE:
        LD A,CR
        OUT (1),A
        RET

; ---- go [back] <type> [from <name>] ------------------------------------
STGO:
        LD A,(STMT)
        INC A
        LD B,A
        LD A,(SEND)
        CP B
        JP Z,STERR
        JP C,STERR
        LD A,B
        LD (GW),A
        CALL WORDAI
        LD DE,MSGBACK
        CALL ISWORD
        OR A
        JR NZ,GO_NB
        LD A,(GW)
        INC A
        LD (GW),A
        LD B,A
        LD A,(SEND)
        CP B
        JP Z,STERR
GO_NB:
        LD HL,MSGQGO
        CALL SENDPART
        LD A,(GW)
        CALL WORDAI
        CALL SENDPART
        ; "from <name>"?
        LD A,(GW)
        INC A
        LD B,A
        LD A,(SEND)
        CP B
        JR Z,GO_SEND
        JR C,GO_SEND
        LD A,B
        LD (GW),A
        CALL WORDAI
        LD DE,MSGFROM
        CALL ISWORD
        OR A
        JP NZ,STERR
        LD A,(GW)
        INC A
        LD B,A
        LD A,(SEND)
        CP B
        JP Z,STERR
        LD A,B
        CALL WORDAI
        CALL NODEID
        LD (VAL),HL
        LD A,(GW)
        ADD A,2
        LD B,A
        LD A,(SEND)
        CP B
        JP NZ,STERR
        LD HL,MSGFROMQ
        CALL SENDPART
        LD A,TAB
        OUT (3),A
        LD HL,MSGC0
        CALL SENDPART
        LD HL,(VAL)
        CALL SENDNUM
GO_SEND:
        LD A,CR
        OUT (3),A
        CALL READANS
        LD HL,ANSBUF
        LD DE,CURSOR
        CALL COPYSTR
        LD HL,ANSBUF
        CALL COUNTIDS
        CALL PNUMU
        LD HL,MSGNODES
        CALL PRSP
        LD A,CR
        OUT (1),A
        RET

; ---- rem ---------------------------------------------------------------
; A comment statement: the rest of the statement is ignored, exactly as
; the host client ignores it.
STREM:
        RET

; ---- add <label> [{<prop> <value>}] ------------------------------------
; The property list is forwarded as it was written, exactly as the host
; forwards it: the guest has no text values, but `add` is a pass-through
; and the host is the parser. The answer is the new node's id, which
; becomes the cursor (PRD §3.1), and the client prints "1 created".
STADD:
        LD A,(STMT)
        INC A
        LD B,A
        LD A,(SEND)
        CP B
        JP Z,STERR
        JP C,STERR
        LD A,B
        LD (GW),A
        LD HL,MSGQADD
        CALL SENDPART
AD1:    LD A,(GW)
        CALL WORDAI
        CALL SENDPART
        LD A,(GW)
        INC A
        LD (GW),A
        LD B,A
        LD A,(SEND)
        CP B
        JR Z,AD2
        JR C,AD2
        LD A,' '
        OUT (3),A
        JR AD1
AD2:    LD A,CR
        OUT (3),A
        CALL READANS
        LD HL,ANSBUF
        LD DE,CURSOR
        CALL COPYSTR
        LD HL,ANSBUF
        CALL COUNTIDS
        CALL PNUMU
        LD HL,MSGCREATED
        CALL PRSP
        LD A,CR
        OUT (1),A
        RET

; ---- link <name> <type> <name> -----------------------------------------
; Two ids and a type, answered with the edge's id — the channel's `link`
; verb, which exists because the engine refuses joins.
STLINK:
        LD A,(STMT)
        ADD A,4
        LD B,A
        LD A,(SEND)
        CP B
        JP NZ,STERR
        LD A,(STMT)
        INC A
        CALL WORDAI
        CALL NODEID
        LD (VAL),HL
        LD A,(STMT)
        ADD A,3
        CALL WORDAI
        CALL NODEID
        LD (VAL2),HL
        LD HL,MSGLINKQ
        CALL SENDPART
        LD HL,(VAL)
        CALL SENDNUM
        LD A,' '
        OUT (3),A
        LD A,(STMT)
        ADD A,2
        CALL WORDAI
        CALL SENDPART
        LD A,' '
        OUT (3),A
        LD HL,(VAL2)
        CALL SENDNUM
        LD A,CR
        OUT (3),A
        CALL READANS
        LD HL,MSGLINKED
        CALL PRSTR
        LD HL,ANSBUF
        CALL PRSTR
        LD A,CR
        OUT (1),A
        RET

; ---- set <name> <prop> = <value> ---------------------------------------
; The node and the value travel as parameters; the value is the client's
; own expression, evaluated here. A text value is not in the guest's
; value model and is refused by GETVAL.
STSET:
        LD A,(STMT)
        ADD A,4
        LD B,A
        LD A,(SEND)
        CP B
        JP Z,STERR
        JP C,STERR
        LD A,(STMT)
        ADD A,3
        CALL WORDAI
        LD DE,MSGEQ
        CALL ISWORD
        OR A
        JR NZ,SE_PLAIN
        LD A,(STMT)
        ADD A,4
        LD (GW),A
        LD B,A
        LD A,(SEND)
        CP B
        JP Z,STERR
        JP C,STERR
        JR SE_GO
SE_PLAIN:
        LD A,(STMT)
        ADD A,3
        LD (GW),A
SE_GO:  LD A,(GW)
        LD (EXW),A
        CALL EVAL
        LD (VAL),HL
        LD A,(RK)
        LD (VALK),A
        LD A,(EXW)
        LD B,A
        LD A,(SEND)
        CP B
        JP NZ,STERR
        LD A,(STMT)
        INC A
        CALL WORDAI
        CALL NODEID
        LD (VAL2),HL
        LD HL,MSGSETQ
        CALL SENDPART
        LD A,(STMT)
        ADD A,2
        CALL WORDAI
        CALL SENDPART
        LD HL,MSGSETV
        CALL SENDPART
        LD A,TAB
        OUT (3),A
        LD HL,MSGPN
        CALL SENDPART
        LD HL,(VAL2)
        CALL SENDNUM
        LD A,TAB
        OUT (3),A
        LD HL,MSGV0
        CALL SENDPART
        LD A,(VALK)
        CP 1
        JR Z,SE_TEXT
        CP 2
        JR Z,SE_BOOL
        LD HL,(VAL)
        CALL SENDNUM
        JR SE_SENT
SE_TEXT:
        LD HL,(VAL)
        CALL SENDQT
        JR SE_SENT
SE_BOOL:
        LD HL,(VAL)
        CALL SENDBOOL
SE_SENT:
        LD A,CR
        OUT (3),A
        CALL READANS
        LD HL,ANSBUF
        CALL PRSTR
        LD HL,MSGUPDATED
        CALL PRSP
        LD A,CR
        OUT (1),A
        RET

; ---- drop <name> -------------------------------------------------------
STDROP:
        LD A,(STMT)
        ADD A,2
        LD B,A
        LD A,(SEND)
        CP B
        JP NZ,STERR
        LD A,(STMT)
        INC A
        CALL WORDAI
        CALL NODEID
        LD (VAL),HL
        LD HL,MSGDROPQ
        CALL SENDPART
        LD A,TAB
        OUT (3),A
        LD HL,MSGPN
        CALL SENDPART
        LD HL,(VAL)
        CALL SENDNUM
        LD A,CR
        OUT (3),A
        CALL READANS
        LD HL,ANSBUF
        CALL PRSTR
        LD HL,MSGDROPPED
        CALL PRSP
        LD A,CR
        OUT (1),A
        RET

; ---- if <cond> then <statement>[: <statement>...] ----------------------
; The host's rule, which is not the obvious one: at the *line* level the
; `if` owns the rest of the line, because the host hands it the rest of
; the string; inside a body the host hands it one piece, so it owns only
; its own tail. LEVEL is the difference: 1 is the line run.
STIF:
        LD A,(STMT)
        INC A
        LD (GW),A
IF_SCAN:
        LD A,(GW)
        LD B,A
        LD A,(SEND)
        CP B
        JP Z,STERR              ; no `then`
        JP C,STERR
        LD A,(GW)
        CALL WORDAI
        LD DE,MSGTHEN
        CALL ISWORD
        OR A
        JR Z,IF_FOUND
        LD A,(GW)
        INC A
        LD (GW),A
        JR IF_SCAN
IF_FOUND:
        ; the tail must be there ("if needs a statement after 'then'")
        LD A,(GW)
        INC A
        LD B,A
        LD A,(SEND)
        CP B
        JP Z,STERR
        JP C,STERR
        ; the condition must be there
        LD A,(GW)
        LD B,A
        LD A,(STMT)
        INC A
        CP B
        JP Z,STERR
        CALL COND
        LD (VAL),HL
        LD A,(EXW)
        LD B,A
        LD A,(GW)
        CP B
        JP NZ,STERR             ; a word the condition did not use
        LD HL,(VAL)
        LD A,H
        OR L
        JR Z,IF_FALSE
        ; run the tail as a statement of its own
        LD A,(SEND)
        LD (VAL2),A
        LD A,(GW)
        INC A
        LD (STMT),A
        LD A,(VAL2)
        LD (SEND),A
        LD A,(LEVEL)
        INC A
        LD (LEVEL),A
        CALL RUNSTMT
        LD A,(LEVEL)
        DEC A
        LD (LEVEL),A
        ; at the line level, the rest of the line follows the if
        LD A,(LEVEL)
        CP 1
        JR NZ,IF_DONE
        LD A,(CURST)
        INC A
        LD B,A
        LD A,(RUNEND)
        LD C,A
        CALL RUNFROM
        LD A,(RUNEND)
        LD (CURST),A
IF_DONE:
        RET
IF_FALSE:
        LD A,(LEVEL)
        CP 1
        JR NZ,IF_DONE           ; one piece of a body: skip only this if
        LD A,(RUNEND)
        LD (CURST),A
        RET

; ---- while <cond> [: <statement>... [next]] ----------------------------
; The unbounded loop, and a line statement by construction: the host
; splits a line into pieces, and a `while` inside a body is a piece with
; no colon after its condition, so the host refuses it. The guest
; refuses it too, by the same LEVEL rule as `if`.
STWHILE:
        LD A,(LEVEL)
        CP 1
        JP NZ,STERR
        ; A missing condition is caught by COND (an empty word refuses),
        ; and a missing body by the empty-range check below: FINDBODY
        ; answers the line end when there is no statement after `while`.
        LD A,(CURST)
        LD (WHST),A
        CALL FINDBODY
        ; FINDBODY leaves STMT/SEND at the last statement it looked at,
        ; and BODYEND is clobbered by a `for` in the body; the while's
        ; own statement and body end are kept here.
        LD A,(BODYEND)
        LD (WHEND),A
        LD B,A
        LD A,(WHST)
        INC A
        CP B
        JP Z,STERR              ; an empty body (the host refuses it too)
        LD HL,0
        LD (WHCNT),HL
WH_TOP:
        LD A,(WHST)
        CALL SETBOUNDS
        CALL COND
        LD A,(EXW)
        LD B,A
        LD A,(SEND)
        CP B
        JP NZ,STERR             ; a word the condition did not use
        LD A,H
        OR L
        JR Z,WH_END
        LD HL,(WHCNT)
        INC HL
        LD (WHCNT),HL
        LD A,H
        OR L
        JR NZ,WH_RUN
        JP STERR                ; 65,536 rounds: the guest's cap
WH_RUN:
        LD A,(WHST)
        INC A
        LD B,A
        LD A,(WHEND)
        LD C,A
        CALL RUNFROM
        JR WH_TOP
WH_END:
        ; the statements after the `next` run once, as the host's `after`
        LD A,(WHEND)
        INC A
        LD B,A
        LD A,(SCOUNT)
        LD C,A
        CALL RUNFROM
        LD A,(SCOUNT)
        LD (CURST),A
        RET

; ---- for ---------------------------------------------------------------
STFOR:
        LD A,(STMT)
        INC A
        LD B,A
        LD A,(SEND)
        CP B
        JP Z,STERR
        JP C,STERR
        LD A,B
        CALL WORDAI
        LD DE,MSGEACH
        CALL ISWORD
        OR A
        JP Z,STFOREACH
        ; for <name> = <expr> to <expr>
        LD A,(STMT)
        ADD A,2
        LD B,A
        LD A,(SEND)
        CP B
        JP Z,STERR
        JP C,STERR
        LD A,B
        CALL WORDAI
        LD DE,MSGEQ
        CALL ISWORD
        OR A
        JP NZ,STERR
        LD A,(STMT)
        ADD A,3
        LD B,A
        LD A,(SEND)
        CP B
        JP Z,STERR
        JP C,STERR
        LD A,(STMT)
        INC A
        LD (NAMEI),A
        LD A,(STMT)
        ADD A,3
        LD (EXW),A
        CALL EVAL
        LD A,(RK)
        OR A
        JP NZ,STERR
        LD (VAL),HL
        LD A,(EXW)
        LD B,A
        LD A,(SEND)
        CP B
        JP Z,STERR
        LD A,(EXW)
        CALL WORDAI
        LD DE,MSGTO
        CALL ISWORD
        OR A
        JP NZ,STERR
        LD A,(EXW)
        INC A
        LD (EXW),A
        CALL EVAL
        LD A,(RK)
        OR A
        JP NZ,STERR
        LD (VAL2),HL
        LD A,(EXW)
        LD B,A
        LD A,(SEND)
        CP B
        JP NZ,STERR
        CALL FINDBODY
        CALL LOOPENTER
        ; the range, in this loop's own slot
        LD HL,FVAL
        CALL FPTR
        LD DE,(VAL)
        LD (HL),E
        INC HL
        LD (HL),D
        LD HL,FLIM
        CALL FPTR
        LD DE,(VAL2)
        LD (HL),E
        INC HL
        LD (HL),D
FL_START:
        ; the current value starts at the first one
        LD HL,FVAL
        CALL FPTR
        LD E,(HL)
        INC HL
        LD D,(HL)
        PUSH DE
        LD HL,FCUR
        CALL FPTR
        POP DE
        LD (HL),E
        INC HL
        LD (HL),D
FL_CHECK:
        ; stop when the current value is past the limit
        LD HL,FCUR
        CALL FPTR
        LD E,(HL)
        INC HL
        LD D,(HL)
        LD H,D
        LD L,E
        LD (VAL3),HL
        LD HL,FLIM
        CALL FPTR
        LD E,(HL)
        INC HL
        LD D,(HL)
        LD HL,(VAL3)
        PUSH HL
        LD H,D
        LD L,E
        POP DE
        CALL CMPHLDE
        JR C,FL_STOP
        ; bind the name
        LD A,(NAMEI)
        CALL WORDAI
        CALL SLOT
        LD DE,8
        ADD HL,DE
        LD DE,(VAL3)
        LD (HL),E
        INC HL
        LD (HL),D
        LD HL,(SLOTK)
        XOR A
        LD (HL),A
        CALL RUNBODY
        ; v = v + 1
        LD HL,FCUR
        CALL FPTR
        LD E,(HL)
        INC HL
        LD D,(HL)
        INC DE
        LD A,D
        OR E
        JR Z,FL_STOP          ; 16 bits cannot count past 65535
        LD (HL),D
        DEC HL
        LD (HL),E
        JR FL_CHECK
FL_STOP:
        CALL LOOPLEAVE
        RET

; ---- for each <name> [do] ----------------------------------------------
STFOREACH:
        LD A,(STMT)
        ADD A,2
        LD (NAMEI),A
        LD B,A
        LD A,(SEND)
        CP B
        JP Z,STERR
        JP C,STERR
        ; an optional "do", and nothing else
        LD A,(NAMEI)
        INC A
        LD B,A
        LD A,(SEND)
        CP B
        JR Z,FE_NODO
        LD A,B
        CALL WORDAI
        LD DE,MSGDO
        CALL ISWORD
        OR A
        JP NZ,STERR
        LD A,(NAMEI)
        ADD A,2
        LD B,A
        LD A,(SEND)
        CP B
        JP NZ,STERR
FE_NODO:
        CALL FINDBODY
        CALL LOOPENTER
        ; the walk uses a copy of the cursor
        CALL CURSLOT
        CALL CLRSLOT
        CALL CURSLOT
        PUSH HL
        EX DE,HL
        LD HL,CURSOR
        CALL COPYSTR
        POP HL
        ; and starts at its beginning
        LD A,(LDIDX)
        DEC A
        LD E,A
        LD D,0
        LD HL,CURP
        ADD HL,DE
        LD (HL),0
FE_TOP:
        CALL NEXTID
        LD A,H
        OR L
        JR Z,FE_DONE
        LD (VAL),HL
        LD A,(NAMEI)
        CALL WORDAI
        CALL SLOT
        LD DE,8
        ADD HL,DE
        LD DE,(VAL)
        LD (HL),E
        INC HL
        LD (HL),D
        LD HL,(SLOTK)
        XOR A
        LD (HL),A
        CALL RUNBODY
        JR FE_TOP
FE_DONE:
        ; the walk leaves the cursor where it found it
        CALL CURSLOT
        LD DE,CURSOR
        CALL COPYSTR
        CALL LOOPLEAVE
        RET

; The body's end: the statement of the `next` that closes this loop, or
; SCOUNT when the loop has none (the one-line form). A nested `for` is
; counted, so a loop is closed by its own `next`.
FINDBODY:
        LD A,(CURST)
        INC A
        LD (FI),A
        LD A,1
        LD (DEPTH),A
FB1:    LD A,(FI)
        LD B,A
        LD A,(SCOUNT)
        CP B
        JR Z,FB_NONE
        JR C,FB_NONE
        LD A,(FI)
        CALL SETBOUNDS
        LD A,D
        CALL WORDAI
        LD DE,MSGFOR
        CALL ISWORD
        OR A
        JR NZ,FB_CHKN
        LD A,(DEPTH)
        INC A
        LD (DEPTH),A
        JR FB_ADV
FB_CHKN:
        LD A,(FI)
        CALL BOUNDS
        LD A,D
        CALL WORDAI
        LD DE,MSGNEXT
        CALL ISWORD
        OR A
        JR NZ,FB_ADV
        LD A,(DEPTH)
        DEC A
        LD (DEPTH),A
        JR NZ,FB_ADV
        LD A,(FI)
        LD (BODYEND),A
        RET
FB_ADV:
        LD A,(FI)
        INC A
        LD (FI),A
        JR FB1
FB_NONE:
        LD A,(SCOUNT)
        LD (BODYEND),A
        RET

; Remember a loop's body range for this depth.
LOOPENTER:
        LD A,(LDIDX)
        CP 4
        JP NC,STERR
        LD E,A
        LD D,0
        LD HL,FSTART
        ADD HL,DE
        LD A,(CURST)
        INC A
        LD (HL),A
        LD A,(LDIDX)
        LD E,A
        LD D,0
        LD HL,FEND
        ADD HL,DE
        LD A,(BODYEND)
        LD (HL),A
        LD A,(LDIDX)
        INC A
        LD (LDIDX),A
        RET

; Close a loop: the rest of the line continues after its `next`.
LOOPLEAVE:
        LD A,(LDIDX)
        DEC A
        LD (LDIDX),A
        LD E,A
        LD D,0
        LD HL,FEND
        ADD HL,DE
        LD A,(HL)
        LD (CURST),A
        RET

; Run the body of the open loop.
RUNBODY:
        LD A,(LDIDX)
        DEC A
        LD E,A
        LD D,0
        LD HL,FSTART
        ADD HL,DE
        LD B,(HL)
        LD HL,FEND
        ADD HL,DE
        LD C,(HL)
        JP RUNFROM

; HL = the save slot of the open loop (CURSAVE + depth*128).
CURSLOT:
        LD A,(LDIDX)
        DEC A
        LD L,A
        LD H,0
        ADD HL,HL
        ADD HL,HL
        ADD HL,HL
        ADD HL,HL
        ADD HL,HL
        ADD HL,HL
        ADD HL,HL
        LD DE,CURSAVE
        ADD HL,DE
        RET

; HL = the address of the open loop's FVAL/FLIM/FCUR entry, given the
; array's base in HL.
FPTR:
        LD A,(LDIDX)
        DEC A
        ADD A,A
        LD E,A
        LD D,0
        ADD HL,DE
        RET

; The next id in the open loop's saved cursor, or 0 at its end.
NEXTID:
        CALL CURSLOT
        LD (TMP2),HL
        LD A,(LDIDX)
        DEC A
        LD E,A
        LD D,0
        LD HL,CURP
        ADD HL,DE
        LD A,(HL)
        LD E,A
        LD D,0
        LD HL,(TMP2)
        ADD HL,DE
        LD A,(HL)
        OR A
        JR Z,NI_NONE
        LD DE,0
NI1:    LD A,(HL)
        CP '0'
        JR C,NI2
        CP 58
        JR NC,NI2
        SUB '0'
        LD C,A
        PUSH HL
        LD H,D
        LD L,E
        ADD HL,HL
        ADD HL,HL
        ADD HL,DE
        ADD HL,HL
        LD B,0
        ADD HL,BC
        LD D,H
        LD E,L
        POP HL
        INC HL
        JR NI1
NI2:    PUSH DE
        LD DE,(TMP2)
        CALL SUB16
        INC HL
        LD C,L
        LD A,(LDIDX)
        DEC A
        LD E,A
        LD D,0
        LD HL,CURP
        ADD HL,DE
        LD (HL),C
        POP DE
        LD H,D
        LD L,E
        RET
NI_NONE:
        LD HL,0
        RET

; HL = HL - DE.
SUB16:
        LD A,L
        SUB E
        LD L,A
        LD A,H
        SBC A,D
        LD H,A
        RET

; Compare HL with DE: Z if they are equal, C if HL < DE.
CMPHLDE:
        LD A,H
        CP D
        RET NZ
        LD A,L
        CP E
        RET

; ---- the refusal -------------------------------------------------------

STERR:
        XOR A
        LD (INPROG),A          ; a refusal ends a program, not the prompt
        LD (PROGSP),A
        LD HL,MSGERR
        CALL PRSTR
        LD A,CR
        OUT (1),A
        JP MAIN

; ---- the strings -------------------------------------------------------

MSGQFIND:  DB "gq find ", 0
