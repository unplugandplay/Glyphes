; ------------------------------------------------------------------------
; gbasic.z80 — GLYPH BASIC on the eZ80.
;
; The second implementation of the client's language, and the reason pin
; GB9 exists: the language has to be small enough to be written twice.
; The host client is Nim; this is Z80 assembly on an eZ80. The proof is
; the *transcript*: the same script, run on both, must produce the same
; bytes (PLAN-GLYPH-BASIC.md §6, E4).
;
; The graph is not here. The guest sends a GLYPH QUERY line over the
; port channel (ez80/channel.z80) and reads the answer back — so the
; guest needs no compiler and no graph, and the host does the work.
;
; What is here is the client's *own* part: the line, the statements, the
; names, the expressions, the loop, the request, the answer and the
; printing.
;
; This cut covers: find, count, labels, end, rem, let and bare
; assignment, print, show, go, if ... then, for, for each, and the writes
; add, link, set and drop. The names are the client's, the expressions
; (arithmetic and comparisons) are the client's, the cursor loop is the
; client's, and the graph — including every write — still happens on the
; other side of the channel.
;
; What it does not cover, and refuses rather than pretending: quoted
; text, input, while, gosub/return, the program model, and the boolean
; operators and/or/not in a condition. A quoted string in a value
; position prints `?` rather than being read as a name with a zero in
; it, an unknown name is refused rather than created, and an answer the
; host refuses (it begins with `!`) is printed as the guest's one-word
; `?` — a refusal the child can see. An expression here is *word-shaped*:
; `1 + 2` is three words and the operators have to stand alone, because
; the guest tokenizes the line into words and has no character-by-
; character parser. That is the price of the budget, and the transcript
; test only exercises what is here.
;
; Assemble:  nim c -r ez80/ez80asm.nim -- ez80/gbasic.z80 ez80/gbasic.bin
; ------------------------------------------------------------------------

CR      EQU 13
TAB     EQU 9

; ---- memory map ----------------------------------------------------
LINEBUF  EQU 0xD400     ; the line as read (100 bytes)
WORDS    EQU 0xD470     ; the word offsets (64 bytes)
STARTS   EQU 0xD4B0     ; the word index each statement starts at (64)

WCOUNT   EQU 0xD4F0     ; the number of words
SCOUNT   EQU 0xD4F1     ; the number of statement boundaries
STMT     EQU 0xD4F2     ; the current statement's first word
SEND     EQU 0xD4F3     ; one past its last word
CURST    EQU 0xD4F4     ; the statement being run
RUNEND   EQU 0xD4F5     ; one past the last statement to run
EXW      EQU 0xD4F6     ; the expression's word cursor
NAMEI    EQU 0xD4F7     ; the statement's name word
GW       EQU 0xD4F8     ; `go`'s word cursor
FI       EQU 0xD4F9     ; the body scan's statement cursor
DEPTH    EQU 0xD4FA     ; the body scan's nesting depth
BODYEND  EQU 0xD4FB     ; the statement a body ends at (the `next`)
NUMCNT   EQU 0xD4FD     ; the digits being formatted
DIVCNT   EQU 0xD4FE     ; the division's counter
PNCNT    EQU 0xD4FF     ; the printed digits
OP       EQU 0xD500     ; the operator being applied
ACC      EQU 0xD501     ; the expression's accumulator (2)
ACC2     EQU 0xD503     ; the right-hand side (2)
VAL      EQU 0xD505     ; a value being moved around (2)
VAL2     EQU 0xD507     ; a second value (2)
VAL3     EQU 0xD509     ; a third value (2)
TXTPTR   EQU 0xD50B     ; the name being looked up (2)
ANSP     EQU 0xD50D     ; the answer line being printed (2)
TMP2     EQU 0xD50F     ; a general scratch (2)
TACC     EQU 0xD511     ; the term's accumulator (2)
TACC2    EQU 0xD513     ; the term's right-hand side (2)
LEVEL    EQU 0xD51E     ; how many RUNFROM frames are open (1 = the line)
MAKE     EQU 0xD51F     ; 1: a name may be created, 0: it must exist
COPE     EQU 0xD51D     ; the condition's comparison operator

ANSBUF   EQU 0xD520     ; the host's answer (128 bytes)
CURSOR   EQU 0xD5A0     ; the cursor as text (128 bytes)
CURSAVE  EQU 0xD620     ; a walk's copy of the cursor (4 x 128)
NAMETAB  EQU 0xD820     ; 8 names: 8 bytes of text and 2 of value
NUMBUF   EQU 0xD870     ; a number as text (16 bytes)
FSTART   EQU 0xD880     ; a loop's first body statement (4)
FEND     EQU 0xD884     ; a loop's body end (4)
CURP     EQU 0xD888     ; a walk's offset in its copy (4)
LDIDX    EQU 0xD88C     ; how many loops are open
FVAL     EQU 0xD890     ; a numeric loop's first value (4 x 2)
FLIM     EQU 0xD898     ; its last value (4 x 2)
FCUR     EQU 0xD8A0     ; where it is (4 x 2)

STKTOP   EQU 0xBFF0

        ORG 0

; ---- startup --------------------------------------------------------
START:
        LD SP,STKTOP
MAIN:
        LD SP,STKTOP        ; a refusal abandons the line, not the stack
        XOR A
        LD (LEVEL),A
        CALL READLINE
        CALL TOKENIZE
        LD B,0
        LD A,(SCOUNT)
        LD C,A
        CALL RUNFROM
        JR MAIN

; ---- the console -----------------------------------------------------

; Print the NUL-terminated string at HL.
PRSTR:
        LD A,(HL)
        OR A
        RET Z
        OUT (1),A
        INC HL
        JR PRSTR

; Print a space, then the string at HL.
PRSP:
        LD A,' '
        OUT (1),A
        JR PRSTR

; Print the number in HL, unsigned decimal.
PNUMU:
        LD A,H
        OR L
        JP NZ,PU1
        LD A,'0'
        CALL PUTCHAR
        RET
PU1:
        XOR A
        LD (PNCNT),A
PUL:
        LD DE,10
        CALL UDIV
        LD A,C
        ADD A,'0'
        PUSH AF
        LD A,(PNCNT)
        INC A
        LD (PNCNT),A
        LD A,H
        OR L
        JP NZ,PUL
PUP:
        POP AF
        CALL PUTCHAR
        LD A,(PNCNT)
        DEC A
        LD (PNCNT),A
        JP NZ,PUP
        RET

PUTCHAR:
        OUT (1),A
        RET

; UDIV: HL / DE. The quotient in HL, the remainder in C.
UDIV:
        LD A,D
        OR E
        JP Z,DVERR
        LD BC,0
        LD A,16
        LD (DIVCNT),A
DVLP:
        ADD HL,HL
        RL C
        RL B
        LD A,C
        SUB E
        LD A,B
        SBC A,D
        JP C,DVSK
        LD A,C
        SUB E
        LD C,A
        LD A,B
        SBC A,D
        LD B,A
        INC L
DVSK:
        LD A,(DIVCNT)
        DEC A
        LD (DIVCNT),A
        JP NZ,DVLP
        RET
DVERR:
        LD A,'?'
        OUT (1),A
        RET

; MUL16: HL * DE -> HL (the low 16 bits). The multiplicand shifts
; left, the multiplier shifts right, and the product gathers in BC.
MUL16:
        LD BC,0
        LD A,16
        LD (DIVCNT),A
MU1:    LD A,E
        AND 1
        JR Z,MU2
        LD A,C
        ADD A,L
        LD C,A
        LD A,B
        ADC A,H
        LD B,A
MU2:    ADD HL,HL
        SRL E
        RR D
        LD A,(DIVCNT)
        DEC A
        LD (DIVCNT),A
        JR NZ,MU1
        LD H,B
        LD L,C
        RET

; ---- the line and the words ------------------------------------------

; Read a line from the console into LINEBUF.
READLINE:
        LD HL,LINEBUF
        LD B,0
RL1:    IN A,(2)
        OR A
        JR Z,RL1
        IN A,(1)
        CP CR
        JR Z,RL2
        LD (HL),A
        INC HL
        INC B
        JR RL1
RL2:    LD (HL),0
        LD A,B
        RET

; Split the line into words and statements.
;
; A word is a run of characters. The space after it becomes its NUL.
; A colon is a *statement boundary*: it becomes a NUL too, and the word
; that follows starts a new statement. STARTS[j] is the word index
; statement j begins at; STARTS[SCOUNT] is WCOUNT (the sentinel), so a
; statement is the words [STARTS[j], STARTS[j+1]).
TOKENIZE:
        LD A,0
        LD (WCOUNT),A
        LD A,1
        LD (SCOUNT),A          ; the line is at least one statement
        LD HL,STARTS
        LD (HL),0
        LD HL,LINEBUF
        LD C,0
TK1:    LD A,(HL)
        OR A
        JP Z,TKEND
        CP ' '
        JR Z,TKSPACE
        CP ':'
        JR Z,TKCOLON
        ; a word begins here
        LD A,(WCOUNT)
        LD E,A
        LD D,0
        PUSH HL
        LD HL,WORDS
        ADD HL,DE
        LD (HL),C
        POP HL
        LD A,(WCOUNT)
        INC A
        LD (WCOUNT),A
TK2:    LD A,(HL)
        OR A
        JP Z,TKEND
        CP ' '
        JR Z,TKSPACE
        CP ':'
        JR Z,TK1              ; the boundary handler takes it
        INC HL
        INC C
        JR TK2
TKSPACE:
        LD A,0
        LD (HL),A
        INC HL
        INC C
        JR TK1
TKCOLON:
        LD A,0
        LD (HL),A
        INC HL
        INC C
        LD A,(SCOUNT)
        LD E,A
        LD D,0
        PUSH HL
        LD HL,STARTS
        ADD HL,DE
        LD A,(WCOUNT)
        LD (HL),A
        POP HL
        LD A,(SCOUNT)
        INC A
        LD (SCOUNT),A
        JR TK1
TKEND:
        LD A,(SCOUNT)
        LD E,A
        LD D,0
        LD HL,STARTS
        ADD HL,DE
        LD A,(WCOUNT)
        LD (HL),A
        RET

; The address of word A (0-based) in HL.
WORDAI:
        LD L,A
        LD H,0
        LD DE,WORDS
        ADD HL,DE
        LD E,(HL)
        LD D,0
        LD HL,LINEBUF
        ADD HL,DE
        RET

; Is the word at HL the keyword at DE? The case is ignored, and the
; answer is in A: 0 for the same, 1 for different.
ISWORD:
ISW1:   LD A,(DE)
        OR A
        JR Z,ISW2
        LD A,(HL)
        OR A
        JR Z,ISWNO
        LD A,(DE)
        CP 'a'
        JR C,ISW3
        CP 123
        JR NC,ISW3
        SUB 32
ISW3:   LD B,A
        LD A,(HL)
        CP 'a'
        JR C,ISW4
        CP 123
        JR NC,ISW4
        SUB 32
ISW4:   CP B
        JR NZ,ISWNO
        INC HL
        INC DE
        JR ISW1
ISW2:   LD A,(HL)
        OR A
        JR Z,ISWYES
ISWNO:  LD A,1
        RET
ISWYES: LD A,0
        RET

; ---- the channel ------------------------------------------------------

; Send the NUL-terminated string at HL to the host, with no terminator.
SENDPART:
        LD A,(HL)
        OR A
        RET Z
        OUT (3),A
        INC HL
        JR SENDPART

; Send the NUL-terminated string at HL to the host, then CR.
SENDSTR:
        CALL SENDPART
        LD A,CR
        OUT (3),A
        RET

; Send the number in HL to the host as decimal.
SENDNUM:
        CALL NUMTXT
        JP SENDPART

; The number in HL as decimal text at NUMBUF.
NUMTXT:
        LD A,0
        LD (NUMCNT),A
NT1:    LD DE,10
        CALL UDIV
        LD A,C
        ADD A,'0'
        PUSH AF
        LD A,(NUMCNT)
        INC A
        LD (NUMCNT),A
        LD A,H
        OR L
        JR NZ,NT1
        LD HL,NUMBUF
NT2:    POP AF
        LD (HL),A
        INC HL
        LD A,(NUMCNT)
        DEC A
        LD (NUMCNT),A
        JR NZ,NT2
        LD (HL),0
        LD HL,NUMBUF
        RET

; Read the host's answer into ANSBUF: the lines are NUL-separated, and
; the answer ends at the empty line.
READANS:
        LD HL,ANSBUF
        LD B,0
RA1:    IN A,(5)
        OR A
        JR Z,RA1
        IN A,(4)
        CP CR
        JR Z,RA2
        LD (HL),A
        INC HL
        INC B
        JR RA1
RA2:    IN A,(5)
        OR A
        JR Z,RA2
        IN A,(4)
        CP CR
        JR Z,RA3
        LD (HL),0
        INC HL
        INC B
        LD (HL),A
        INC HL
        INC B
        JR RA1
RA3:    LD (HL),0
        INC HL
        LD (HL),0             ; the empty line: the answer's end
        LD A,(ANSBUF)
        CP 33                 ; a refusal: the host says why, the guest
        JP Z,STERR            ; refuses by name — its one word for it
        RET

; Count the ids (the runs of digits) in the line at HL.
COUNTIDS:
        LD DE,0
CI1:    LD A,(HL)
        OR A
        JR Z,CIDONE
        CP '0'
        JR C,CINEXT
        CP 58
        JR NC,CINEXT
        INC DE
CI2:    INC HL
        LD A,(HL)
        CP '0'
        JR C,CI1
        CP 58
        JR NC,CI1
        JR CI2
CINEXT: INC HL
        JR CI1
CIDONE: LD H,D
        LD L,E
        RET

; Print the NUL-separated lines at HL, one per line.
PRTLINES:
        LD A,(HL)
        OR A
        RET Z
PT2:    LD A,(HL)
        OR A
        JR Z,PT3
        OUT (1),A
        INC HL
        JR PT2
PT3:    LD A,CR
        OUT (1),A
        INC HL
        JR PRTLINES

; Does the text at HL begin with the prefix at DE? Z if it does.
PREFIX:
        LD A,(DE)
        OR A
        JR Z,PYES
        LD B,A
        LD A,(HL)
        CP B
        JR NZ,PNO
        INC HL
        INC DE
        JR PREFIX
PYES:   XOR A
        RET
PNO:    LD A,1
        OR A
        RET

; Advance ANSP past the line it points at.
ANSNEXT:
        LD HL,(ANSP)
AN1:    LD A,(HL)
        OR A
        JR Z,AN2
        INC HL
        JR AN1
AN2:    INC HL
        LD (ANSP),HL
        RET

; Copy the NUL-terminated string at HL to DE.
COPYSTR:
        LD A,(HL)
        LD (DE),A
        OR A
        RET Z
        INC HL
        INC DE
        JR COPYSTR

; Clear the 128 bytes at HL.
CLRSLOT:
        LD B,128
        LD A,0
CL1:    LD (HL),A
        INC HL
        DJNZ CL1
        RET

; ---- the names --------------------------------------------------------

; Are the name at DE and the text at HL the same? Z if they are.
NAMEEQ:
        PUSH DE
NE1:    LD A,(DE)
        OR A
        JR Z,NEY
        LD B,A
        LD A,(HL)
        CP B
        JR NZ,NEN
        INC HL
        INC DE
        JR NE1
NEY:    LD A,(HL)
        OR A
        JR NZ,NEN
        POP DE
        XOR A
        RET
NEN:    POP DE
        LD A,1
        OR A
        RET

; The slot for the name at HL, and it must already exist: this is the
; reader's rule (`x` in an expression is a name the program made, and an
; unknown one is a refusal, not a new name with a zero in it).
FINDNAME:
        XOR A
        LD (MAKE),A
        JR SLOT0

; The slot for the name at HL. A new name is given a slot with a value
; of zero; a name that does not fit is refused.
SLOT:
        LD A,1
        LD (MAKE),A
SLOT0:
        LD (TXTPTR),HL
        LD DE,NAMETAB
        LD B,8
SL1:    PUSH BC
        PUSH DE
        LD HL,(TXTPTR)
        CALL NAMEEQ
        POP DE
        POP BC
        JR Z,SLHIT
        LD A,E
        ADD A,10
        LD E,A
        JR NC,SL2
        INC D
SL2:    DJNZ SL1
        LD DE,NAMETAB
        LD B,8
SL3:    LD A,(DE)
        OR A
        JR Z,SLNEW
        LD A,E
        ADD A,10
        LD E,A
        JR NC,SL4
        INC D
SL4:    DJNZ SL3
        JP STERR
SLHIT:  LD H,D
        LD L,E
        RET
SLNEW:
        LD A,(MAKE)
        OR A
        JP Z,STERR
        PUSH DE
        LD HL,(TXTPTR)
        LD B,7
SLC1:   LD A,(HL)
        OR A
        JR Z,SLC2
        LD (DE),A
        INC HL
        INC DE
        DEC B
        JR NZ,SLC1
SLC2:   LD A,0
        LD (DE),A
        POP HL
        PUSH HL
        LD DE,8
        ADD HL,DE
        LD (HL),0
        INC HL
        LD (HL),0
        POP HL
        RET

; The value of the word at HL: a number, or a name's value.
GETVAL:
        LD (TXTPTR),HL
GV1:    LD A,(HL)
        OR A
        JR Z,GVNUM
        CP '0'
        JR C,GVNAME
        CP 58
        JR NC,GVNAME
        INC HL
        JR GV1
GVNUM:  LD HL,(TXTPTR)
        JP PARSENUM
GVNAME: LD HL,(TXTPTR)
        LD A,(HL)
        CP 34                 ; a quoted string is not in the guest's
        JP Z,STERR            ; value model: refused, not read as a name
        CALL FINDNAME
        LD DE,8
        ADD HL,DE
        LD E,(HL)
        INC HL
        LD D,(HL)
        LD H,D
        LD L,E
        RET

; The decimal number at HL, in HL.
PARSENUM:
        LD DE,0
PN1:    LD A,(HL)
        OR A
        JR Z,PN2
        SUB '0'
        LD C,A
        PUSH HL
        LD H,D
        LD L,E
        ADD HL,HL
        ADD HL,HL
        ADD HL,DE
        ADD HL,HL
        LD B,0
        ADD HL,BC
        LD D,H
        LD E,L
        POP HL
        INC HL
        JR PN1
PN2:    LD H,D
        LD L,E
        RET

; ---- the expressions ---------------------------------------------------

; The word at EXW, or the empty string.
PEEKW:
        LD A,(EXW)
        LD B,A
        LD A,(SEND)
        CP B
        JR Z,PKE
        JR C,PKE
        LD A,B
        CALL WORDAI
        RET
PKE:    LD HL,MSGEMPTY
        RET

; expr := term (('+'|'-') term)*
EXPR:
        CALL TERM
        LD (ACC),HL
EXL:    CALL PEEKW
        LD A,(HL)
        CP '+'
        JR Z,EXOP
        CP '-'
        JR Z,EXOP
        LD HL,(ACC)
        RET
EXOP:   LD (OP),A
        LD A,(EXW)
        INC A
        LD (EXW),A
        CALL TERM
        LD (ACC2),HL
        LD HL,(ACC)
        LD DE,(ACC2)
        LD A,(OP)
        CP '+'
        JR Z,EXADD
        JR EXSUB
EXADD:  ADD HL,DE
        JR EXST
EXSUB:  CALL SUB16
EXST:   LD (ACC),HL
        JR EXL

; term := primary (('*'|'/') primary)*
TERM:
        CALL PRIMARY
        LD (TACC),HL
TML:    CALL PEEKW
        LD A,(HL)
        CP '*'
        JR Z,TMOP
        CP '/'
        JR Z,TMOP
        LD HL,(TACC)
        RET
TMOP:   LD (OP),A
        LD A,(EXW)
        INC A
        LD (EXW),A
        CALL PRIMARY
        LD (TACC2),HL
        LD HL,(TACC)
        LD DE,(TACC2)
        LD A,(OP)
        CP '*'
        JR NZ,TMDIV
        CALL MUL16
        JR TMST
TMDIV:  CALL UDIV
TMST:   LD (TACC),HL
        JR TML

; primary := a number | a name
PRIMARY:
        CALL PEEKW
        LD A,(HL)
        OR A
        JP Z,STERR
        CALL GETVAL
        LD A,(EXW)
        INC A
        LD (EXW),A
        RET

; ---- the conditions ----------------------------------------------------
;
; cond := add (('='|'<'|'>'|'<='|'>='|'<>') add)?
;
; A comparison is *one* comparison, and the operator is a word of its
; own — the guest's word-shaped rule. `and` and `or` are not here: a
; condition that used one leaves a word unconsumed, and the caller
; refuses rather than guessing. A bare value is true when it is not
; zero, which is the host's `truthy`.
COND:
        CALL EXPR
        LD (VAL),HL
        CALL PEEKW
        LD A,(HL)
        CP '='
        JR Z,CD_EQ
        CP '<'
        JR Z,CD_LT
        CP '>'
        JR Z,CD_GT
        ; no operator: the value itself is the condition
        LD HL,(VAL)
        LD A,H
        OR L
        JP Z,CD_FALSE
        JP CD_TRUE
CD_EQ:  LD A,'='
        JR CD_OP
CD_LT:  INC HL
        LD A,(HL)
        CP '='
        JR Z,CD_LE
        CP '>'
        JR Z,CD_NE
        LD A,'<'
        JR CD_OP
CD_LE:  LD A,'l'
        JR CD_OP
CD_NE:  LD A,'n'
        JR CD_OP
CD_GT:  INC HL
        LD A,(HL)
        CP '='
        JR Z,CD_GE
        LD A,'>'
        JR CD_OP
CD_GE:  LD A,'g'
CD_OP:  LD (COPE),A
        LD A,(EXW)
        INC A
        LD (EXW),A
        CALL EXPR
        LD (VAL2),HL
        LD HL,(VAL)
        LD DE,(VAL2)
        LD A,(COPE)
        CP '='
        JR Z,CD_C_EQ
        CP 'n'
        JR Z,CD_C_NE
        CP '<'
        JR Z,CD_C_LT
        CP 'l'
        JR Z,CD_C_LE
        CP '>'
        JR Z,CD_C_GT
        ; 'g'
        CALL CMPHLDE
        JR C,CD_FALSE
        JR CD_TRUE
CD_C_LT: CALL CMPHLDE
        JR C,CD_TRUE
        JR CD_FALSE
CD_C_GT: CALL CMPHLDE
        JR Z,CD_FALSE
        JR C,CD_FALSE
        JR CD_TRUE
CD_C_EQ: CALL CMPHLDE
        JR Z,CD_TRUE
        JR CD_FALSE
CD_C_NE: CALL CMPHLDE
        JR NZ,CD_TRUE
        JR CD_FALSE
CD_C_LE: CALL CMPHLDE
        JR Z,CD_TRUE
        JR C,CD_TRUE
        JR CD_FALSE
CD_TRUE: LD HL,1
        RET
CD_FALSE: LD HL,0
        RET

; ---- the statements ----------------------------------------------------

; Run the statements [B, C).
RUNFROM:
        LD A,B
        CP C
        RET NC                 ; an empty (or reversed) range runs nothing
        LD A,(LEVEL)
        INC A
        LD (LEVEL),A
        LD A,(RUNEND)
        PUSH AF
        LD A,C
        LD (RUNEND),A
        LD A,B
        LD (CURST),A
RF1:    CALL RUNONE
        LD A,(CURST)
        INC A
        LD (CURST),A
        LD B,A
        LD A,(RUNEND)
        CP B
        JR Z,RF2
        JR C,RF2
        JR RF1
RF2:    POP AF
        LD (RUNEND),A
        LD A,(LEVEL)
        DEC A
        LD (LEVEL),A
        RET

; Run the statement at CURST.
RUNONE:
        LD A,(CURST)
        CALL BOUNDS
        LD A,D
        LD (STMT),A
        LD A,E
        LD (SEND),A
        LD A,E
        CP D
        RET Z
        JP RUNSTMT

; A = statement index -> D = its first word, E = one past its last.
BOUNDS:
        LD L,A
        LD H,0
        LD DE,STARTS
        ADD HL,DE
        LD A,(HL)
        INC HL
        LD E,(HL)
        LD D,A
        RET

RUNSTMT:
        ; a bare assignment: word[STMT+1] is "="
        LD A,(STMT)
        INC A
        LD B,A
        LD A,(SEND)
        CP B
        JR C,RS_KW
        JR Z,RS_KW
        LD A,B
        LD (EXW),A
        CALL WORDAI
        LD DE,MSGEQ
        CALL ISWORD
        OR A
        JP Z,STASSIGN
RS_KW:
        LD A,(STMT)
        CALL WORDAI
        LD DE,MSGFIND
        CALL ISWORD
        OR A
        JP Z,STFIND
        LD A,(STMT)
        CALL WORDAI
        LD DE,MSGCOUNT
        CALL ISWORD
        OR A
        JP Z,STCOUNT
        LD A,(STMT)
        CALL WORDAI
        LD DE,MSGLABELS
        CALL ISWORD
        OR A
        JP Z,STLABELS
        LD A,(STMT)
        CALL WORDAI
        LD DE,MSGEND
        CALL ISWORD
        OR A
        JP Z,STEND
        LD A,(STMT)
        CALL WORDAI
        LD DE,MSGLET
        CALL ISWORD
        OR A
        JP Z,STLET
        LD A,(STMT)
        CALL WORDAI
        LD DE,MSGPRINT
        CALL ISWORD
        OR A
        JP Z,STPRINT
        LD A,(STMT)
        CALL WORDAI
        LD DE,MSGSHOW
        CALL ISWORD
        OR A
        JP Z,STSHOW
        LD A,(STMT)
        CALL WORDAI
        LD DE,MSGGO
        CALL ISWORD
        OR A
        JP Z,STGO
        LD A,(STMT)
        CALL WORDAI
        LD DE,MSGIF
        CALL ISWORD
        OR A
        JP Z,STIF
        LD A,(STMT)
        CALL WORDAI
        LD DE,MSGREM
        CALL ISWORD
        OR A
        JP Z,STREM
        LD A,(STMT)
        CALL WORDAI
        LD DE,MSGADD
        CALL ISWORD
        OR A
        JP Z,STADD
        LD A,(STMT)
        CALL WORDAI
        LD DE,MSGLINK
        CALL ISWORD
        OR A
        JP Z,STLINK
        LD A,(STMT)
        CALL WORDAI
        LD DE,MSGSET
        CALL ISWORD
        OR A
        JP Z,STSET
        LD A,(STMT)
        CALL WORDAI
        LD DE,MSGDROP
        CALL ISWORD
        OR A
        JP Z,STDROP
        LD A,(STMT)
        CALL WORDAI
        LD DE,MSGFOR
        CALL ISWORD
        OR A
        JP Z,STFOR
        JP STERR

; ---- find <label> ------------------------------------------------------
STFIND:
        LD A,(STMT)
        INC A
        LD B,A
        LD A,(SEND)
        CP B
        JP Z,STERR
        JP C,STERR
        LD A,(STMT)
        ADD A,2
        LD B,A
        LD A,(SEND)
        CP B
        JP NZ,STERR
        LD HL,MSGQFIND
        CALL SENDPART
        LD A,(STMT)
        INC A
        CALL WORDAI
        CALL SENDSTR
        CALL READANS
        LD HL,ANSBUF
        LD DE,CURSOR
        CALL COPYSTR
        LD HL,ANSBUF
        CALL COUNTIDS
        CALL PNUMU
        LD HL,MSGNODES
        CALL PRSP
        LD A,CR
        OUT (1),A
        RET

; ---- count <label> -----------------------------------------------------
STCOUNT:
        LD A,(STMT)
        INC A
        LD B,A
        LD A,(SEND)
        CP B
        JP Z,STERR
        JP C,STERR
        LD A,(STMT)
        ADD A,2
        LD B,A
        LD A,(SEND)
        CP B
        JP NZ,STERR
        LD HL,MSGQCOUNT
        CALL SENDPART
        LD A,(STMT)
        INC A
        CALL WORDAI
        CALL SENDSTR
        CALL READANS
        LD HL,ANSBUF
        CALL PRSTR
        LD A,CR
        OUT (1),A
        RET

; ---- labels ------------------------------------------------------------
STLABELS:
        LD HL,MSGQLABELS
        CALL SENDSTR
        CALL READANS
        LD HL,ANSBUF
        CALL PRTLINES
        RET

; ---- end ---------------------------------------------------------------
STEND:
        HALT

; ---- let <name> = <expr> -----------------------------------------------
STLET:
        LD A,(STMT)
        ADD A,2
        LD B,A
        LD A,(SEND)
        CP B
        JP Z,STERR
        JP C,STERR
        LD A,B
        CALL WORDAI
        LD DE,MSGEQ
        CALL ISWORD
        OR A
        JP NZ,STERR
        LD A,(STMT)
        ADD A,3
        LD B,A
        LD A,(SEND)
        CP B
        JP Z,STERR
        JP C,STERR
        LD A,(STMT)
        INC A
        LD (NAMEI),A
        ADD A,2
        LD (EXW),A
        CALL EXPR
        LD (VAL),HL
        LD A,(EXW)
        LD B,A
        LD A,(SEND)
        CP B
        JP NZ,STERR
        LD A,(NAMEI)
        CALL WORDAI
        CALL SLOT
        LD DE,8
        ADD HL,DE
        LD DE,(VAL)
        LD (HL),E
        INC HL
        LD (HL),D
        RET

; ---- <name> = <expr> ---------------------------------------------------
STASSIGN:
        LD A,(STMT)
        ADD A,2
        LD B,A
        LD A,(SEND)
        CP B
        JP Z,STERR
        JP C,STERR
        LD A,(STMT)
        LD (NAMEI),A
        LD A,(STMT)
        ADD A,2
        LD (EXW),A
        CALL EXPR
        LD (VAL),HL
        LD A,(EXW)
        LD B,A
        LD A,(SEND)
        CP B
        JP NZ,STERR
        LD A,(NAMEI)
        CALL WORDAI
        CALL SLOT
        LD DE,8
        ADD HL,DE
        LD DE,(VAL)
        LD (HL),E
        INC HL
        LD (HL),D
        RET

; ---- print [<expr>] ----------------------------------------------------
STPRINT:
        LD A,(STMT)
        INC A
        LD B,A
        LD A,(SEND)
        CP B
        JR Z,PRCUR
        LD A,B
        LD (EXW),A
        CALL EXPR
        LD (VAL),HL
        LD A,(EXW)
        LD B,A
        LD A,(SEND)
        CP B
        JP NZ,STERR
        LD HL,(VAL)
        CALL PNUMU
        LD A,CR
        OUT (1),A
        RET
PRCUR:
        LD HL,CURSOR
        CALL COUNTIDS
        LD A,H
        OR L
        JR Z,PR_EMPTY
        CALL PNUMU
        LD HL,MSGNODES
        CALL PRSP
        LD A,CR
        OUT (1),A
        RET
PR_EMPTY:
        LD HL,MSGCURSOREMPTY
        CALL PRSTR
        LD A,CR
        OUT (1),A
        RET

; ---- show <name> -------------------------------------------------------
STSHOW:
        LD A,(STMT)
        INC A
        LD B,A
        LD A,(SEND)
        CP B
        JP Z,STERR
        JP C,STERR
        LD A,(STMT)
        ADD A,2
        LD B,A
        LD A,(SEND)
        CP B
        JP NZ,STERR
        LD A,(STMT)
        INC A
        CALL WORDAI
        CALL GETVAL
        LD (VAL),HL
        CALL PNUMU
        ; the label and the properties
        LD HL,MSGQPROPS
        CALL SENDPART
        LD HL,(VAL)
        CALL SENDNUM
        LD A,CR
        OUT (3),A
        CALL READANS
        LD HL,ANSBUF
        LD (ANSP),HL
        LD HL,(ANSP)
        LD DE,MSGPROPLABEL
        CALL PREFIX
        JR NZ,SH_PROP
        LD HL,MSGCOLON
        CALL PRSTR
        LD HL,(ANSP)
        LD DE,6
        ADD HL,DE
        CALL PRSTR
        CALL ANSNEXT
SH_PROP:
        LD HL,(ANSP)
        LD A,(HL)
        OR A
        JR Z,SH_EDGES
        LD A,CR
        OUT (1),A
        LD HL,MSGINDENT
        CALL PRSTR
        LD HL,(ANSP)
        CALL PRSTR
        CALL ANSNEXT
        JR SH_PROP
SH_EDGES:
        LD HL,MSGQEDGES
        CALL SENDPART
        LD HL,(VAL)
        CALL SENDNUM
        LD A,CR
        OUT (3),A
        CALL READANS
        LD HL,ANSBUF
        LD (ANSP),HL
SH_E2:
        LD HL,(ANSP)
        LD A,(HL)
        OR A
        JR Z,SH_DONE
        LD A,CR
        OUT (1),A
        LD HL,MSGINDENT
        CALL PRSTR
        LD HL,(ANSP)
        CALL PRSTR
        CALL ANSNEXT
        JR SH_E2
SH_DONE:
        LD A,CR
        OUT (1),A
        RET

; ---- go [back] <type> [from <name>] ------------------------------------
STGO:
        LD A,(STMT)
        INC A
        LD B,A
        LD A,(SEND)
        CP B
        JP Z,STERR
        JP C,STERR
        LD A,B
        LD (GW),A
        CALL WORDAI
        LD DE,MSGBACK
        CALL ISWORD
        OR A
        JR NZ,GO_NB
        LD A,(GW)
        INC A
        LD (GW),A
        LD B,A
        LD A,(SEND)
        CP B
        JP Z,STERR
GO_NB:
        LD HL,MSGQGO
        CALL SENDPART
        LD A,(GW)
        CALL WORDAI
        CALL SENDPART
        ; "from <name>"?
        LD A,(GW)
        INC A
        LD B,A
        LD A,(SEND)
        CP B
        JR Z,GO_SEND
        JR C,GO_SEND
        LD A,B
        LD (GW),A
        CALL WORDAI
        LD DE,MSGFROM
        CALL ISWORD
        OR A
        JP NZ,STERR
        LD A,(GW)
        INC A
        LD B,A
        LD A,(SEND)
        CP B
        JP Z,STERR
        LD A,B
        CALL WORDAI
        CALL GETVAL
        LD (VAL),HL
        LD A,(GW)
        ADD A,2
        LD B,A
        LD A,(SEND)
        CP B
        JP NZ,STERR
        LD HL,MSGFROMQ
        CALL SENDPART
        LD A,TAB
        OUT (3),A
        LD HL,MSGC0
        CALL SENDPART
        LD HL,(VAL)
        CALL SENDNUM
GO_SEND:
        LD A,CR
        OUT (3),A
        CALL READANS
        LD HL,ANSBUF
        LD DE,CURSOR
        CALL COPYSTR
        LD HL,ANSBUF
        CALL COUNTIDS
        CALL PNUMU
        LD HL,MSGNODES
        CALL PRSP
        LD A,CR
        OUT (1),A
        RET

; ---- rem ---------------------------------------------------------------
; A comment statement: the rest of the statement is ignored, exactly as
; the host client ignores it.
STREM:
        RET

; ---- add <label> [{<prop> <value>}] ------------------------------------
; The property list is forwarded as it was written, exactly as the host
; forwards it: the guest has no text values, but `add` is a pass-through
; and the host is the parser. The answer is the new node's id, which
; becomes the cursor (PRD §3.1), and the client prints "1 created".
STADD:
        LD A,(STMT)
        INC A
        LD B,A
        LD A,(SEND)
        CP B
        JP Z,STERR
        JP C,STERR
        LD A,B
        LD (GW),A
        LD HL,MSGQADD
        CALL SENDPART
AD1:    LD A,(GW)
        CALL WORDAI
        CALL SENDPART
        LD A,(GW)
        INC A
        LD (GW),A
        LD B,A
        LD A,(SEND)
        CP B
        JR Z,AD2
        JR C,AD2
        LD A,' '
        OUT (3),A
        JR AD1
AD2:    LD A,CR
        OUT (3),A
        CALL READANS
        LD HL,ANSBUF
        LD DE,CURSOR
        CALL COPYSTR
        LD HL,ANSBUF
        CALL COUNTIDS
        CALL PNUMU
        LD HL,MSGCREATED
        CALL PRSP
        LD A,CR
        OUT (1),A
        RET

; ---- link <name> <type> <name> -----------------------------------------
; Two ids and a type, answered with the edge's id — the channel's `link`
; verb, which exists because the engine refuses joins.
STLINK:
        LD A,(STMT)
        ADD A,4
        LD B,A
        LD A,(SEND)
        CP B
        JP NZ,STERR
        LD A,(STMT)
        INC A
        CALL WORDAI
        CALL GETVAL
        LD (VAL),HL
        LD A,(STMT)
        ADD A,3
        CALL WORDAI
        CALL GETVAL
        LD (VAL2),HL
        LD HL,MSGLINKQ
        CALL SENDPART
        LD HL,(VAL)
        CALL SENDNUM
        LD A,' '
        OUT (3),A
        LD A,(STMT)
        ADD A,2
        CALL WORDAI
        CALL SENDPART
        LD A,' '
        OUT (3),A
        LD HL,(VAL2)
        CALL SENDNUM
        LD A,CR
        OUT (3),A
        CALL READANS
        LD HL,MSGLINKED
        CALL PRSTR
        LD HL,ANSBUF
        CALL PRSTR
        LD A,CR
        OUT (1),A
        RET

; ---- set <name> <prop> = <value> ---------------------------------------
; The node and the value travel as parameters; the value is the client's
; own expression, evaluated here. A text value is not in the guest's
; value model and is refused by GETVAL.
STSET:
        LD A,(STMT)
        ADD A,4
        LD B,A
        LD A,(SEND)
        CP B
        JP Z,STERR
        JP C,STERR
        LD A,(STMT)
        ADD A,3
        CALL WORDAI
        LD DE,MSGEQ
        CALL ISWORD
        OR A
        JR NZ,SE_PLAIN
        LD A,(STMT)
        ADD A,4
        LD (GW),A
        LD B,A
        LD A,(SEND)
        CP B
        JP Z,STERR
        JP C,STERR
        JR SE_GO
SE_PLAIN:
        LD A,(STMT)
        ADD A,3
        LD (GW),A
SE_GO:  LD A,(GW)
        LD (EXW),A
        CALL EXPR
        LD (VAL),HL
        LD A,(EXW)
        LD B,A
        LD A,(SEND)
        CP B
        JP NZ,STERR
        LD A,(STMT)
        INC A
        CALL WORDAI
        CALL GETVAL
        LD (VAL2),HL
        LD HL,MSGSETQ
        CALL SENDPART
        LD A,(STMT)
        ADD A,2
        CALL WORDAI
        CALL SENDPART
        LD HL,MSGSETV
        CALL SENDPART
        LD A,TAB
        OUT (3),A
        LD HL,MSGPN
        CALL SENDPART
        LD HL,(VAL2)
        CALL SENDNUM
        LD A,TAB
        OUT (3),A
        LD HL,MSGV0
        CALL SENDPART
        LD HL,(VAL)
        CALL SENDNUM
        LD A,CR
        OUT (3),A
        CALL READANS
        LD HL,ANSBUF
        CALL PRSTR
        LD HL,MSGUPDATED
        CALL PRSP
        LD A,CR
        OUT (1),A
        RET

; ---- drop <name> -------------------------------------------------------
STDROP:
        LD A,(STMT)
        ADD A,2
        LD B,A
        LD A,(SEND)
        CP B
        JP NZ,STERR
        LD A,(STMT)
        INC A
        CALL WORDAI
        CALL GETVAL
        LD (VAL),HL
        LD HL,MSGDROPQ
        CALL SENDPART
        LD A,TAB
        OUT (3),A
        LD HL,MSGPN
        CALL SENDPART
        LD HL,(VAL)
        CALL SENDNUM
        LD A,CR
        OUT (3),A
        CALL READANS
        LD HL,ANSBUF
        CALL PRSTR
        LD HL,MSGDROPPED
        CALL PRSP
        LD A,CR
        OUT (1),A
        RET

; ---- if <cond> then <statement>[: <statement>...] ----------------------
; The host's rule, which is not the obvious one: at the *line* level the
; `if` owns the rest of the line, because the host hands it the rest of
; the string; inside a body the host hands it one piece, so it owns only
; its own tail. LEVEL is the difference: 1 is the line run.
STIF:
        LD A,(STMT)
        INC A
        LD (GW),A
IF_SCAN:
        LD A,(GW)
        LD B,A
        LD A,(SEND)
        CP B
        JP Z,STERR              ; no `then`
        JP C,STERR
        LD A,(GW)
        CALL WORDAI
        LD DE,MSGTHEN
        CALL ISWORD
        OR A
        JR Z,IF_FOUND
        LD A,(GW)
        INC A
        LD (GW),A
        JR IF_SCAN
IF_FOUND:
        ; the tail must be there ("if needs a statement after 'then'")
        LD A,(GW)
        INC A
        LD B,A
        LD A,(SEND)
        CP B
        JP Z,STERR
        JP C,STERR
        ; the condition must be there
        LD A,(GW)
        LD B,A
        LD A,(STMT)
        INC A
        CP B
        JP Z,STERR
        LD (EXW),A
        CALL COND
        LD (VAL),HL
        LD A,(EXW)
        LD B,A
        LD A,(GW)
        CP B
        JP NZ,STERR             ; a word the condition did not use
        LD HL,(VAL)
        LD A,H
        OR L
        JR Z,IF_FALSE
        ; run the tail as a statement of its own
        LD A,(SEND)
        LD (VAL2),A
        LD A,(GW)
        INC A
        LD (STMT),A
        LD A,(VAL2)
        LD (SEND),A
        LD A,(LEVEL)
        INC A
        LD (LEVEL),A
        CALL RUNSTMT
        LD A,(LEVEL)
        DEC A
        LD (LEVEL),A
        ; at the line level, the rest of the line follows the if
        LD A,(LEVEL)
        CP 1
        JR NZ,IF_DONE
        LD A,(CURST)
        INC A
        LD B,A
        LD A,(RUNEND)
        LD C,A
        CALL RUNFROM
        LD A,(RUNEND)
        LD (CURST),A
IF_DONE:
        RET
IF_FALSE:
        LD A,(LEVEL)
        CP 1
        JR NZ,IF_DONE           ; one piece of a body: skip only this if
        LD A,(RUNEND)
        LD (CURST),A
        RET

; ---- for ---------------------------------------------------------------
STFOR:
        LD A,(STMT)
        INC A
        LD B,A
        LD A,(SEND)
        CP B
        JP Z,STERR
        JP C,STERR
        LD A,B
        CALL WORDAI
        LD DE,MSGEACH
        CALL ISWORD
        OR A
        JP Z,STFOREACH
        ; for <name> = <expr> to <expr>
        LD A,(STMT)
        ADD A,2
        LD B,A
        LD A,(SEND)
        CP B
        JP Z,STERR
        JP C,STERR
        LD A,B
        CALL WORDAI
        LD DE,MSGEQ
        CALL ISWORD
        OR A
        JP NZ,STERR
        LD A,(STMT)
        ADD A,3
        LD B,A
        LD A,(SEND)
        CP B
        JP Z,STERR
        JP C,STERR
        LD A,(STMT)
        INC A
        LD (NAMEI),A
        LD A,(STMT)
        ADD A,3
        LD (EXW),A
        CALL EXPR
        LD (VAL),HL
        LD A,(EXW)
        LD B,A
        LD A,(SEND)
        CP B
        JP Z,STERR
        LD A,(EXW)
        CALL WORDAI
        LD DE,MSGTO
        CALL ISWORD
        OR A
        JP NZ,STERR
        LD A,(EXW)
        INC A
        LD (EXW),A
        CALL EXPR
        LD (VAL2),HL
        LD A,(EXW)
        LD B,A
        LD A,(SEND)
        CP B
        JP NZ,STERR
        CALL FINDBODY
        CALL LOOPENTER
        ; the range, in this loop's own slot
        LD HL,FVAL
        CALL FPTR
        LD DE,(VAL)
        LD (HL),E
        INC HL
        LD (HL),D
        LD HL,FLIM
        CALL FPTR
        LD DE,(VAL2)
        LD (HL),E
        INC HL
        LD (HL),D
FL_START:
        ; the current value starts at the first one
        LD HL,FVAL
        CALL FPTR
        LD E,(HL)
        INC HL
        LD D,(HL)
        PUSH DE
        LD HL,FCUR
        CALL FPTR
        POP DE
        LD (HL),E
        INC HL
        LD (HL),D
FL_CHECK:
        ; stop when the current value is past the limit
        LD HL,FCUR
        CALL FPTR
        LD E,(HL)
        INC HL
        LD D,(HL)
        LD H,D
        LD L,E
        LD (VAL3),HL
        LD HL,FLIM
        CALL FPTR
        LD E,(HL)
        INC HL
        LD D,(HL)
        LD HL,(VAL3)
        PUSH HL
        LD H,D
        LD L,E
        POP DE
        CALL CMPHLDE
        JR C,FL_STOP
        ; bind the name
        LD A,(NAMEI)
        CALL WORDAI
        CALL SLOT
        LD DE,8
        ADD HL,DE
        LD DE,(VAL3)
        LD (HL),E
        INC HL
        LD (HL),D
        CALL RUNBODY
        ; v = v + 1
        LD HL,FCUR
        CALL FPTR
        LD E,(HL)
        INC HL
        LD D,(HL)
        INC DE
        LD A,D
        OR E
        JR Z,FL_STOP          ; 16 bits cannot count past 65535
        LD (HL),D
        DEC HL
        LD (HL),E
        JR FL_CHECK
FL_STOP:
        CALL LOOPLEAVE
        RET

; ---- for each <name> [do] ----------------------------------------------
STFOREACH:
        LD A,(STMT)
        ADD A,2
        LD (NAMEI),A
        LD B,A
        LD A,(SEND)
        CP B
        JP Z,STERR
        JP C,STERR
        ; an optional "do", and nothing else
        LD A,(NAMEI)
        INC A
        LD B,A
        LD A,(SEND)
        CP B
        JR Z,FE_NODO
        LD A,B
        CALL WORDAI
        LD DE,MSGDO
        CALL ISWORD
        OR A
        JP NZ,STERR
        LD A,(NAMEI)
        ADD A,2
        LD B,A
        LD A,(SEND)
        CP B
        JP NZ,STERR
FE_NODO:
        CALL FINDBODY
        CALL LOOPENTER
        ; the walk uses a copy of the cursor
        CALL CURSLOT
        CALL CLRSLOT
        CALL CURSLOT
        PUSH HL
        EX DE,HL
        LD HL,CURSOR
        CALL COPYSTR
        POP HL
        ; and starts at its beginning
        LD A,(LDIDX)
        DEC A
        LD E,A
        LD D,0
        LD HL,CURP
        ADD HL,DE
        LD (HL),0
FE_TOP:
        CALL NEXTID
        LD A,H
        OR L
        JR Z,FE_DONE
        LD (VAL),HL
        LD A,(NAMEI)
        CALL WORDAI
        CALL SLOT
        LD DE,8
        ADD HL,DE
        LD DE,(VAL)
        LD (HL),E
        INC HL
        LD (HL),D
        CALL RUNBODY
        JR FE_TOP
FE_DONE:
        ; the walk leaves the cursor where it found it
        CALL CURSLOT
        LD DE,CURSOR
        CALL COPYSTR
        CALL LOOPLEAVE
        RET

; The body's end: the statement of the `next` that closes this loop, or
; SCOUNT when the loop has none (the one-line form). A nested `for` is
; counted, so a loop is closed by its own `next`.
FINDBODY:
        LD A,(CURST)
        INC A
        LD (FI),A
        LD A,1
        LD (DEPTH),A
FB1:    LD A,(FI)
        LD B,A
        LD A,(SCOUNT)
        CP B
        JR Z,FB_NONE
        JR C,FB_NONE
        LD A,(FI)
        CALL BOUNDS
        LD A,D
        LD (STMT),A
        LD A,E
        LD (SEND),A
        LD A,D
        CALL WORDAI
        LD DE,MSGFOR
        CALL ISWORD
        OR A
        JR NZ,FB_CHKN
        LD A,(DEPTH)
        INC A
        LD (DEPTH),A
        JR FB_ADV
FB_CHKN:
        LD A,(FI)
        CALL BOUNDS
        LD A,D
        CALL WORDAI
        LD DE,MSGNEXT
        CALL ISWORD
        OR A
        JR NZ,FB_ADV
        LD A,(DEPTH)
        DEC A
        LD (DEPTH),A
        JR NZ,FB_ADV
        LD A,(FI)
        LD (BODYEND),A
        RET
FB_ADV:
        LD A,(FI)
        INC A
        LD (FI),A
        JR FB1
FB_NONE:
        LD A,(SCOUNT)
        LD (BODYEND),A
        RET

; Remember a loop's body range for this depth.
LOOPENTER:
        LD A,(LDIDX)
        CP 4
        JP NC,STERR
        LD E,A
        LD D,0
        LD HL,FSTART
        ADD HL,DE
        LD A,(CURST)
        INC A
        LD (HL),A
        LD A,(LDIDX)
        LD E,A
        LD D,0
        LD HL,FEND
        ADD HL,DE
        LD A,(BODYEND)
        LD (HL),A
        LD A,(LDIDX)
        INC A
        LD (LDIDX),A
        RET

; Close a loop: the rest of the line continues after its `next`.
LOOPLEAVE:
        LD A,(LDIDX)
        DEC A
        LD (LDIDX),A
        LD E,A
        LD D,0
        LD HL,FEND
        ADD HL,DE
        LD A,(HL)
        LD (CURST),A
        RET

; Run the body of the open loop.
RUNBODY:
        LD A,(LDIDX)
        DEC A
        LD E,A
        LD D,0
        LD HL,FSTART
        ADD HL,DE
        LD B,(HL)
        LD HL,FEND
        ADD HL,DE
        LD C,(HL)
        JP RUNFROM

; HL = the save slot of the open loop (CURSAVE + depth*128).
CURSLOT:
        LD A,(LDIDX)
        DEC A
        LD L,A
        LD H,0
        ADD HL,HL
        ADD HL,HL
        ADD HL,HL
        ADD HL,HL
        ADD HL,HL
        ADD HL,HL
        ADD HL,HL
        LD DE,CURSAVE
        ADD HL,DE
        RET

; HL = the address of the open loop's FVAL/FLIM/FCUR entry, given the
; array's base in HL.
FPTR:
        LD A,(LDIDX)
        DEC A
        ADD A,A
        LD E,A
        LD D,0
        ADD HL,DE
        RET

; The next id in the open loop's saved cursor, or 0 at its end.
NEXTID:
        CALL CURSLOT
        LD (TMP2),HL
        LD A,(LDIDX)
        DEC A
        LD E,A
        LD D,0
        LD HL,CURP
        ADD HL,DE
        LD A,(HL)
        LD E,A
        LD D,0
        LD HL,(TMP2)
        ADD HL,DE
        LD A,(HL)
        OR A
        JR Z,NI_NONE
        LD DE,0
NI1:    LD A,(HL)
        CP '0'
        JR C,NI2
        CP 58
        JR NC,NI2
        SUB '0'
        LD C,A
        PUSH HL
        LD H,D
        LD L,E
        ADD HL,HL
        ADD HL,HL
        ADD HL,DE
        ADD HL,HL
        LD B,0
        ADD HL,BC
        LD D,H
        LD E,L
        POP HL
        INC HL
        JR NI1
NI2:    PUSH DE
        LD DE,(TMP2)
        CALL SUB16
        INC HL
        LD C,L
        LD A,(LDIDX)
        DEC A
        LD E,A
        LD D,0
        LD HL,CURP
        ADD HL,DE
        LD (HL),C
        POP DE
        LD H,D
        LD L,E
        RET
NI_NONE:
        LD HL,0
        RET

; HL = HL - DE.
SUB16:
        LD A,L
        SUB E
        LD L,A
        LD A,H
        SBC A,D
        LD H,A
        RET

; Compare HL with DE: Z if they are equal, C if HL < DE.
CMPHLDE:
        LD A,H
        CP D
        RET NZ
        LD A,L
        CP E
        RET

; ---- the refusal -------------------------------------------------------

STERR:
        LD HL,MSGERR
        CALL PRSTR
        LD A,CR
        OUT (1),A
        JP MAIN

